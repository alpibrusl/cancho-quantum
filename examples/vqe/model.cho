edition 7;

module vqe.model;

import qc.gates;
import qc.measure;
import qc.profile;
import std.fmt;
import std.io;
import std.json;
import std.math;

// The problem of `examples/vqe` (README.md there): the ground state energy of a transverse-field Ising chain of four qubits,
//
//     H = - Z0 Z1 - Z1 Z2 - Z2 Z3 - h (X0 + X1 + X2 + X3)        h = 1, the critical field,
//
// by a hardware-efficient ansatz: `layers` times (Ry on every qubit, then CX down the chain), then one more layer of Ry. Parameter `l * 4 + q` is the angle of the Ry on qubit `q` in layer `l`.

pub fn qubits() -> [] int {
    return 4;
}

pub fn field() -> [] float {
    return 1.0;
}

// the number of parameters of an ansatz with `layers` layers
pub fn parameters(layers: int) -> [] int {
    return qubits() * (layers + 1);
}

// The state of the ansatz at `theta` (as many angles as `parameters(layers)`), into `st`, which holds 2 << 4 floats.
pub fn prepare[&s, &t](st: &!s [float], theta: &t [float], layers: int) -> [] int {
    let n = qubits();
    var k = 0;
    while k < len(st) {
        st[k] = 0.0;
        k = k + 1;
    }
    st[0] = 1.0;
    var l = 0;
    while l <= layers {
        var q = 0;
        while q < n {
            gates.ry(st, n, q, theta[l * n + q]);
            q = q + 1;
        }
        if l < layers {
            var c = 0;
            while c + 1 < n {
                gates.cx(st, n, c, c + 1);
                c = c + 1;
            }
        }
        l = l + 1;
    }
    return 0;
}

// <psi|H|psi> for the state `st`: the Z Z terms from the probabilities, the X terms from the amplitudes (<X_q> = 2 Re sum over b with bit q clear of conj(a_b) a_(b with q set)).
pub fn expectation[&s](st: &s [float]) -> [] float {
    let n = qubits();
    var zz = 0.0;
    var b = 0;
    while b < 1 << n {
        let p = st[2 * b] * st[2 * b] + st[2 * b + 1] * st[2 * b + 1];
        var q = 0;
        while q + 1 < n {
            var sign = 1.0;
            if b >> q & 1 != b >> q + 1 & 1 {
                sign = 0.0 - 1.0;
            }
            zz = zz + sign * p;
            q = q + 1;
        }
        b = b + 1;
    }
    var xs = 0.0;
    var q2 = 0;
    while q2 < n {
        var s = 0.0;
        var b2 = 0;
        while b2 < 1 << n {
            if b2 >> q2 & 1 == 0 {
                let c = b2 | 1 << q2;
                s = s + st[2 * b2] * st[2 * c] + st[2 * b2 + 1] * st[2 * c + 1];
            }
            b2 = b2 + 1;
        }
        xs = xs + 2.0 * s;
        q2 = q2 + 1;
    }
    return 0.0 - zz - field() * xs;
}

pub fn energy[&s, &t](st: &!s [float], theta: &t [float], layers: int) -> [] float {
    prepare(st, theta, layers);
    return expectation(st);
}

// The energy at `theta` and its gradient, into `grad`, by the parameter-shift rule: each angle is the angle of an Ry, a rotation by exp(-i theta Y / 2), whose generator has eigenvalues +-1/2, so
// dE/dtheta_j = (E(theta_j + pi/2) - E(theta_j - pi/2)) / 2 *exactly* (not a finite difference). `theta` is changed and put back.
pub fn gradient[&s, &t, &g](st: &!s [float], theta: &!t [float], layers: int, grad: &!g [float]) -> [] float {
    let e = energy(st, theta, layers);
    let half_pi = gates.pi() / 2.0;
    var j = 0;
    while j < len(theta) {
        let keep = theta[j];
        theta[j] = keep + half_pi;
        let up = energy(st, theta, layers);
        theta[j] = keep - half_pi;
        let down = energy(st, theta, layers);
        theta[j] = keep;
        grad[j] = (up - down) / 2.0;
        j = j + 1;
    }
    return e;
}

// ---- sampled energies ---------------------------------------------------------------------------------------------------------------------------------------------

// The seed of the sampler for the angles `theta`: FNV-1a over their bits, mixed with `seed`, never 0 (a function of the angles, so the objective is a function).
pub fn seed_of[&t](theta: &t [float], seed: int) -> [] int {
    var h = 1469598103934665603;
    var k = 0;
    while k < len(theta) {
        h = wrapping_mul(h ^ bits_of(theta[k]), 1099511628211);
        k = k + 1;
    }
    h = wrapping_add(wrapping_mul(h ^ seed, 6364136223846793005), 1442695040888963407);
    if h == 0 {
        return 1;
    }
    return h;
}

// +1 for a bit that is 0, -1 for one that is 1
fn spin(b: int, q: int) -> [] float {
    if b >> q & 1 == 0 {
        return 1.0;
    }
    return 0.0 - 1.0;
}

// The energy estimated from `shots` samples of the state in the Z basis and `shots` in the X basis (a Hadamard on every qubit first), each bit read wrongly with the probability set in `rng`
// (`readout_ppm` parts per million, as `set_readout`); `mitigate` divides the expectations by their known read-out factors. `st` holds the 2 << 4 floats of the state, `st2` the same for the X basis,
// `picks` `shots` integers.
pub fn sampled[&s, &u, &t, &r, &p](st: &!s [float], st2: &!u [float], theta: &t [float], layers: int, shots: int, seed: int, readout_ppm: int, mitigate: bool, rng: &!r [int], picks: &!p [int]) -> [] float {
    let n = qubits();
    prepare(st, theta, layers);
    var k = 0;
    while k < len(st) {
        st2[k] = st[k];
        k = k + 1;
    }
    profile.init(rng, seed_of(theta, seed));
    if readout_ppm > 0 {
        rng[2] = readout_ppm;
        rng[3] = 1000000;
    }
    measure.sample(st, n, rng, picks);
    var zz = 0.0;
    k = 0;
    while k < shots {
        var q = 0;
        while q + 1 < n {
            zz = zz + spin(picks[k], q) * spin(picks[k], q + 1);
            q = q + 1;
        }
        k = k + 1;
    }
    zz = zz / float_of(shots);
    var q2 = 0;
    while q2 < n {
        gates.h(st2, n, q2);
        q2 = q2 + 1;
    }
    measure.sample(st2, n, rng, picks);
    var xs = 0.0;
    k = 0;
    while k < shots {
        var q3 = 0;
        while q3 < n {
            xs = xs + spin(picks[k], q3);
            q3 = q3 + 1;
        }
        k = k + 1;
    }
    xs = xs / float_of(shots);
    if mitigate && readout_ppm > 0 {
        let keep = 1.0 - 2.0 * float_of(readout_ppm) / 1000000.0;
        zz = zz / (keep * keep);
        xs = xs / keep;
    }
    return 0.0 - zz - field() * xs;
}

// The sampled energy at `theta` and its gradient by the parameter-shift rule, each of the 2 P + 1 energies sampled on its own (the seed depends on the shifted angles).
pub fn sampled_gradient[&s, &u, &t, &g, &r, &p](st: &!s [float], st2: &!u [float], theta: &!t [float], layers: int, shots: int, seed: int, readout_ppm: int, mitigate: bool, rng: &!r [int], picks: &!p [int], grad: &!g [float]) -> [] float {
    let e = sampled(st, st2, theta, layers, shots, seed, readout_ppm, mitigate, rng, picks);
    let half_pi = gates.pi() / 2.0;
    var j = 0;
    while j < len(theta) {
        let keep = theta[j];
        theta[j] = keep + half_pi;
        let up = sampled(st, st2, theta, layers, shots, seed, readout_ppm, mitigate, rng, picks);
        theta[j] = keep - half_pi;
        let down = sampled(st, st2, theta, layers, shots, seed, readout_ppm, mitigate, rng, picks);
        theta[j] = keep;
        grad[j] = (up - down) / 2.0;
        j = j + 1;
    }
    return e;
}

// The exact ground state energy, from the 16 x 16 matrix of H (written into `m`, 256 floats) by cyclic Jacobi rotations until the off-diagonal part is below 1e-28.
pub fn ground[&m](m: &!m [float]) -> [] float {
    let n = qubits();
    let size = 1 << n;
    var b = 0;
    while b < size * size {
        m[b] = 0.0;
        b = b + 1;
    }
    b = 0;
    while b < size {
        var d = 0.0;
        var q = 0;
        while q + 1 < n {
            if b >> q & 1 != b >> q + 1 & 1 {
                d = d + 1.0;
            } else {
                d = d - 1.0;
            }
            q = q + 1;
        }
        m[b * size + b] = d;
        var f = 0;
        while f < n {
            m[b * size + (b ^ 1 << f)] = 0.0 - field();
            f = f + 1;
        }
        b = b + 1;
    }
    var sweep = 0;
    var off = 1.0;
    while sweep < 60 && off > 0.0000000000000000000000000001 {
        off = 0.0;
        var p = 0;
        while p < size {
            var q2 = p + 1;
            while q2 < size {
                off = off + m[p * size + q2] * m[p * size + q2];
                q2 = q2 + 1;
            }
            p = p + 1;
        }
        p = 0;
        while p + 1 < size {
            var q3 = p + 1;
            while q3 < size {
                let apq = m[p * size + q3];
                if math.fabs(apq) > 0.0000000000000000000000000000001 {
                    let theta = (m[q3 * size + q3] - m[p * size + p]) / (2.0 * apq);
                    var t = 1.0 / (math.fabs(theta) + sqrt(theta * theta + 1.0));
                    if theta < 0.0 {
                        t = 0.0 - t;
                    }
                    let c = 1.0 / sqrt(t * t + 1.0);
                    let s = t * c;
                    var k = 0;
                    while k < size {
                        let akp = m[k * size + p];
                        let akq = m[k * size + q3];
                        m[k * size + p] = c * akp - s * akq;
                        m[k * size + q3] = s * akp + c * akq;
                        k = k + 1;
                    }
                    k = 0;
                    while k < size {
                        let apk = m[p * size + k];
                        let aqk = m[q3 * size + k];
                        m[p * size + k] = c * apk - s * aqk;
                        m[q3 * size + k] = s * apk + c * aqk;
                        k = k + 1;
                    }
                }
                q3 = q3 + 1;
            }
            p = p + 1;
        }
        sweep = sweep + 1;
    }
    var low = m[0];
    var i = 1;
    while i < size {
        if m[i * size + i] < low {
            low = m[i * size + i];
        }
        i = i + 1;
    }
    return low;
}

fn is_blank(c: int) -> [] bool {
    return c == 32 || c == 10 || c == 13 || c == 9;
}

// The angles on standard input (numbers separated by white space; at most 64) into `theta`; how many, or -1 after a refusal printed on standard error (`program` names the program). The count must be 4 per layer plus 4.
pub fn read_angles[&i, &t, &p](io: &!i Io, theta: &!t [float], program: &p [byte]) -> [io_read, err_write] int {
    var status = 0;
    var count = 0;
    region r {
        let tok = alloc_slice[r](64, byte_of(0));
        var used = 0;
        var c = getchar(io);
        while c >= 0 && status == 0 {
            if is_blank(c) {
                if used > 0 {
                    let (ok, v) = number(tok[0..used]);
                    if !ok || count >= len(theta) {
                        status = 1;
                    } else {
                        theta[count] = v;
                        count = count + 1;
                    }
                    used = 0;
                }
            } else if used < 64 {
                tok[used] = byte_of(c);
                used = used + 1;
            } else {
                status = 1;
            }
            c = getchar(io);
        }
        if status == 0 && used > 0 {
            let (ok2, v2) = number(tok[0..used]);
            if !ok2 || count >= len(theta) {
                status = 1;
            } else {
                theta[count] = v2;
                count = count + 1;
            }
        }
        if status == 0 && (count < qubits() * 2 || count % qubits() != 0) {
            status = 1;
        }
    }
    if status != 0 {
        io.error_all(io, program);
        io.error_all(io, ": the input must be numbers separated by white space, 4 per layer plus 4 (8, 12, 16, ... up to 64)\n");
        return 0 - 1;
    }
    return count;
}

// A number as text (`0.3`, `-1e-2`) read by way of the JSON reader; (false, 0) when it is not one.
pub fn number[&s](tok: &s [byte]) -> [] (bool, float) {
    if len(tok) == 0 {
        return (false, 0.0);
    }
    var ok = false;
    var out = 0.0;
    region r {
        let src = alloc_slice[r](len(tok) + 2, byte_of(0));
        src[0] = byte_of('[');
        var k = 0;
        while k < len(tok) {
            src[1 + k] = tok[k];
            k = k + 1;
        }
        src[len(tok) + 1] = byte_of(']');
        let all = src[0..len(tok) + 2];
        let tape = alloc_slice[r](json.tape_len(all), 0);
        if json.parse(all, tape) > 0 && json.is_number(tape, 1) && json.count(tape, 0) == 1 {
            out = json.to_float(all, tape, 1);
            ok = out - out == 0.0;
        }
    }
    return (ok, out);
}
