edition 7;

// `vqe`: a variational quantum eigensolver in cancho (README.md). It asks cancho-opt's `opt minimize` (Nelder-Mead) for the angles that minimise the energy of the state that `vqe-energy` prepares,
// and prints the result next to the exact ground state energy.
//
//     vqe [--method bfgs|nelder-mead|spsa] [--layers L] [--restarts R] [--opt PATH] [--energy PATH] [--gradient PATH] [--maxfev N] [--maxiter N] [--a A] [--c C] [--stability S]
//         [--shots S [--seed K] [--readout P] [--mitigate] [--sampled PATH]]
//
// With `--method spsa` (`opt minimize --method spsa`, no gradient, two evaluations per iteration whatever the number of angles) the optimiser runs `--maxiter` iterations (default 200) with step gain `--a` (default 0.3) and probe size `--c` (default 0.2; chosen on seeds 101-104 of the study, README.md) and stability constant `--stability` (opt's default, a tenth of the iterations); `--seed` is also its seed; `converged` then means that it
// completed its iterations (SPSA has no convergence test), and the shots spent are `evaluations` times 2 S.
//
// L is 1 to 4 (default 2: 12 angles). The default method is BFGS (`opt minimize --method bfgs` on `vqe-gradient`, whose gradient is exact: the parameter-shift rule), one run. With `--method nelder-mead` (on `vqe-energy`) a single run
// stops early in this many dimensions (it can "converge" on a point that is not a minimum), so `opt` is started R times (default 4), each from where the last one stopped. `--opt` and `--energy` are the programs to start (defaults `opt` and `vqe-energy`, found on PATH). One JSON object on standard output:
//
//     {"method": "bfgs", "layers": 2, "parameters": 12, "exact": E0, "energy": E, "error": E - E0, "evaluations": N, "gradients": G, "restarts": R, "converged": true}
//
// With `--shots S` the energy is the one `vqe-sampled` estimates from 2 S shots (README.md, "Sampling"); `energy` is then what the optimiser saw, `true_energy` the exact energy at the angles it found (`vqe-energy` run once more), and
// `shots` the total spent, counting one run of the objective for each distinct point (`gradients` of them for BFGS, `evaluations` for Nelder-Mead). The status is 0 when `opt` converged, 1 when it stopped at its limit (the result is printed all the same), 2 on a refusal.
import qc.gates;
import std.buffer;
import std.bytes;
import std.io;
import std.json;
import std.fmt;
import std.process;
import vqe.model;

fn refuse[&i, &r](io: &!i Io, what: &r [byte]) -> [err_write] int {
    io.error_all(io, "vqe: ");
    io.error_all(io, what);
    io.error_all(io, "\n");
    return 2;
}

fn status_of(ran: process.Ran) -> [] int {
    match ran {
        process.Ran::Code(n) => {
            return n;
        }
        process.Ran::Signaled(s) => {
            return 0 - 4;
        }
        process.Ran::TimedOut => {
            return 255;
        }
        process.Ran::TooMuch => {
            return 255;
        }
        process.Ran::Failed(e) => {
            return 255;
        }
    }
}

// The value of `--flag VALUE`, or an empty slice.
fn flag[&g](args: &g Args, name: &static [byte]) -> [args] &static [byte] {
    var k = 1;
    while k + 1 < arg_count(args) {
        if bytes.equal(arg(args, k), name) {
            return arg(args, k + 1);
        }
        k = k + 1;
    }
    return arg(args, 0)[0..0];
}

// `opt` started with `argv`; its status (255 when it could not be run) and standard output.
fn run_opt[&h, &i, &x, &c, &p, &a, &n](heap: &!h Heap, io: &!i Io, exec: &x Exec(""), clock: &c Clock, exe: &p [byte], argv: &a [byte], input: &n [byte]) -> [heap, err_write, exec(""), clock, poll] (int, buffer.Buffer) {
    var out = buffer.empty(heap, 0);
    var rc = 255;
    match process.channels_with_errors() {
        process.ChannelsWithErrors::Failed(e) => {
            refuse(io, "cannot make the pipes to start opt");
        }
        process.ChannelsWithErrors::Ok(to_child, child_in, from_child, child_out, from_errors, child_errors) => {
            match exec_spawn(exec, exe, argv, "PATH=/usr/local/bin:/usr/bin:/bin\0HOME=/tmp\0", Stdio::Pipe(child_in), Stdio::Pipe(child_out), Stdio::Pipe(child_errors)) {
                Spawned::Failed(e) => {
                    process.close(to_child, from_child);
                    pipe_close(from_errors);
                    refuse(io, "cannot start opt: is it built, and on the PATH or given with --opt?");
                }
                Spawned::Ok(child) => {
                    let (got, errors, ran) = process.capture_both(heap, clock, child, to_child, from_child, from_errors, input, 1048576, 1048576, 600000);
                    buffer.drop(heap, out);
                    buffer.drop(heap, errors);
                    out = got;
                    rc = status_of(ran);
                }
            }
        }
    }
    return (rc, out);
}

// `text` without the white space at its ends
fn trim[&s](text: &s [byte]) -> [] &s [byte] {
    var a = 0;
    var b = len(text);
    while a < b && (int_of(text[a]) == ' ' || int_of(text[a]) == 10 || int_of(text[a]) == 13) {
        a = a + 1;
    }
    while b > a && (int_of(text[b - 1]) == ' ' || int_of(text[b - 1]) == 10 || int_of(text[b - 1]) == 13) {
        b = b - 1;
    }
    return text[a..b];
}

// the number written in `text` (digits only), or -1
fn digits[&s](text: &s [byte]) -> [] int {
    if len(text) == 0 || len(text) > 9 {
        return 0 - 1;
    }
    var v = 0;
    var k = 0;
    while k < len(text) {
        let c = int_of(text[k]);
        if c < '0' || c > '9' {
            return 0 - 1;
        }
        v = v * 10 + (c - '0');
        k = k + 1;
    }
    return v;
}

fn command[&h, &i, &x, &c, &g](heap: &!h Heap, io: &!i Io, exec: &x Exec(""), clock: &c Clock, args: &g Args) -> [heap, io_write, err_write, exec(""), clock, poll, args] int {
    var layers = 2;
    let layer_text = flag(args, "--layers");
    if len(layer_text) > 0 {
        if len(layer_text) != 1 || int_of(layer_text[0]) < '1' || int_of(layer_text[0]) > '4' {
            return refuse(io, "--layers is 1, 2, 3 or 4");
        }
        layers = int_of(layer_text[0]) - '0';
    }
    var opt_path = flag(args, "--opt");
    if len(opt_path) == 0 {
        opt_path = "opt";
    }
    var energy_path = flag(args, "--energy");
    if len(energy_path) == 0 {
        energy_path = "vqe-energy";
    }
    var maxfev = flag(args, "--maxfev");
    if len(maxfev) == 0 {
        maxfev = "6000";
    }
    var gradient_path = flag(args, "--gradient");
    if len(gradient_path) == 0 {
        gradient_path = "vqe-gradient";
    }
    var shots = 0;
    let shots_text = flag(args, "--shots");
    if len(shots_text) > 0 {
        shots = digits(shots_text);
        if shots < 1 || shots > 4096 {
            return refuse(io, "--shots is 1 to 4096");
        }
    }
    var sampled_path = flag(args, "--sampled");
    if len(sampled_path) == 0 {
        sampled_path = "vqe-sampled";
    }
    let seed_text = flag(args, "--seed");
    let readout_text = flag(args, "--readout");
    var mitigate = false;
    var k1 = 1;
    while k1 < arg_count(args) {
        if bytes.equal(arg(args, k1), "--mitigate") {
            mitigate = true;
        }
        k1 = k1 + 1;
    }
    var use_bfgs = true;
    var use_spsa = false;
    let method_text = flag(args, "--method");
    if len(method_text) > 0 {
        if bytes.equal(method_text, "nelder-mead") {
            use_bfgs = false;
        } else if bytes.equal(method_text, "spsa") {
            use_bfgs = false;
            use_spsa = true;
        } else if !bytes.equal(method_text, "bfgs") {
            return refuse(io, "--method is bfgs, nelder-mead or spsa");
        }
    }
    var maxiter = flag(args, "--maxiter");
    if len(maxiter) == 0 {
        maxiter = "200";
    }
    var gain = flag(args, "--a");
    if len(gain) == 0 {
        gain = "0.3";
    }
    var probe = flag(args, "--c");
    if len(probe) == 0 {
        probe = "0.2";
    }
    let stability = flag(args, "--stability");
    var restarts = 4;
    if use_bfgs || use_spsa {
        restarts = 1;
    }
    let restart_text = flag(args, "--restarts");
    if len(restart_text) > 0 {
        if len(restart_text) != 1 || int_of(restart_text[0]) < '1' || int_of(restart_text[0]) > '9' {
            return refuse(io, "--restarts is 1 to 9");
        }
        restarts = int_of(restart_text[0]) - '0';
    }
    let count = model.parameters(layers);
    // the starting point: 0.3 everywhere, then wherever the previous run stopped
    let point = box_slice(heap, count, 0.3);
    var status = 0;
    var best = 0.0;
    var evaluations = 0;
    var gradients = 0;
    var converged = false;
    var round = 0;
    while round < restarts && status == 0 {
        var argv = buffer.append(heap, buffer.empty(heap, 512), "minimize\0--x0\0");
        borrow point as &pr in {
            var k = 0;
            while k < count {
                if k > 0 {
                    argv = buffer.push(heap, argv, byte_of(','));
                }
                region r {
                    let scratch = alloc_slice[r](32, byte_of(0));
                    let n = fmt.float_into(scratch, contents(pr)[k]);
                    argv = buffer.append(heap, argv, scratch[0..n]);
                }
                k = k + 1;
            }
        }
        if use_bfgs {
            argv = buffer.append(heap, argv, "\0--method\0bfgs\0--gtol\01e-6\0--maxiter\01000\0--\0");
            if shots > 0 {
                argv = buffer.append(heap, argv, sampled_path);
            } else {
                argv = buffer.append(heap, argv, gradient_path);
            }
        } else if use_spsa {
            argv = buffer.append(heap, argv, "\0--method\0spsa\0--maxiter\0");
            argv = buffer.append(heap, argv, maxiter);
            argv = buffer.append(heap, argv, "\0--a\0");
            argv = buffer.append(heap, argv, gain);
            argv = buffer.append(heap, argv, "\0--c\0");
            argv = buffer.append(heap, argv, probe);
            if len(stability) > 0 {
                argv = buffer.append(heap, argv, "\0--stability\0");
                argv = buffer.append(heap, argv, stability);
            }
            if len(seed_text) > 0 {
                argv = buffer.append(heap, argv, "\0--seed\0");
                argv = buffer.append(heap, argv, seed_text);
            }
            argv = buffer.append(heap, argv, "\0--\0");
            if shots > 0 {
                argv = buffer.append(heap, argv, sampled_path);
            } else {
                argv = buffer.append(heap, argv, energy_path);
            }
        } else {
            argv = buffer.append(heap, argv, "\0--step\00.4\0--xatol\01e-7\0--fatol\01e-10\0--maxfev\0");
            argv = buffer.append(heap, argv, maxfev);
            argv = buffer.append(heap, argv, "\0--\0");
            if shots > 0 {
                argv = buffer.append(heap, argv, sampled_path);
            } else {
                argv = buffer.append(heap, argv, energy_path);
            }
        }
        if shots > 0 {
            argv = buffer.append(heap, argv, "\0--shots\0");
            argv = buffer.append(heap, argv, shots_text);
            if len(seed_text) > 0 {
                argv = buffer.append(heap, argv, "\0--seed\0");
                argv = buffer.append(heap, argv, seed_text);
            }
            if len(readout_text) > 0 {
                argv = buffer.append(heap, argv, "\0--readout\0");
                argv = buffer.append(heap, argv, readout_text);
            }
            if mitigate {
                argv = buffer.append(heap, argv, "\0--mitigate");
            }
            if use_bfgs {
                argv = buffer.append(heap, argv, "\0--gradient");
            }
        }
        argv = buffer.push(heap, argv, byte_of(0));
        var rc = 255;
        var got = buffer.empty(heap, 0);
        borrow argv as &ar in {
            let (r2, o2) = run_opt(heap, io, exec, clock, opt_path, buffer.bytes(ar), "");
            rc = r2;
            buffer.drop(heap, got);
            got = o2;
        }
        buffer.drop(heap, argv);
        if rc != 0 && rc != 1 {
            status = refuse(io, "opt failed (its error is on its standard error: run the command by hand)");
        } else {
            borrow got as &gr in {
                let src = buffer.bytes(gr);
                let tape = box_slice(heap, json.tape_len(src), 0);
                borrow mut tape as &!tw in {
                    let t = contents(tw);
                    var xs = 0 - 1;
                    if json.parse(src, t) > 0 {
                        xs = json.get(src, t, 0, "x");
                    }
                    if xs < 0 || json.count(t, xs) != count || json.get(src, t, 0, "fun") < 0 {
                        status = refuse(io, "opt printed something that is not its result");
                    } else {
                        best = json.to_float(src, t, json.get(src, t, 0, "fun"));
                        evaluations = evaluations + json.to_int(src, t, json.get(src, t, 0, "nfev"));
                        if use_bfgs {
                            gradients = gradients + json.to_int(src, t, json.get(src, t, 0, "njev"));
                        }
                        if use_spsa {
                            converged = json.to_bool(t, json.get(src, t, 0, "completed"));
                        } else {
                            converged = json.to_bool(t, json.get(src, t, 0, "converged"));
                        }
                        borrow mut point as &!pw in {
                            var m2 = 0;
                            while m2 < count {
                                contents(pw)[m2] = json.to_float(src, t, json.at(t, xs, m2));
                                m2 = m2 + 1;
                            }
                        }
                    }
                }
                unbox_slice(heap, tape);
            }
        }
        buffer.drop(heap, got);
        round = round + 1;
    }
    // the exact energy at the angles found
    var true_energy = best;
    if status == 0 {
        var text = buffer.empty(heap, 256);
        borrow point as &pr in {
            var k2 = 0;
            while k2 < count {
                if k2 > 0 {
                    text = buffer.push(heap, text, byte_of(' '));
                }
                region r {
                    let scratch = alloc_slice[r](32, byte_of(0));
                    let n = fmt.float_into(scratch, contents(pr)[k2]);
                    text = buffer.append(heap, text, scratch[0..n]);
                }
                k2 = k2 + 1;
            }
        }
        var got2 = buffer.empty(heap, 0);
        var rc2 = 255;
        borrow text as &tr in {
            let (r3, o3) = run_opt(heap, io, exec, clock, energy_path, "", buffer.bytes(tr));
            rc2 = r3;
            buffer.drop(heap, got2);
            got2 = o3;
        }
        borrow got2 as &g2 in {
            let (okv, v) = model.number(trim(buffer.bytes(g2)));
            if rc2 == 0 && okv {
                true_energy = v;
            } else {
                status = refuse(io, "vqe-energy did not give the energy at the angles found");
            }
        }
        buffer.drop(heap, got2);
        buffer.drop(heap, text);
    }
    unbox_slice(heap, point);
    if status == 0 {
        let m = box_slice(heap, 256, 0.0);
        var exact = 0.0;
        borrow mut m as &!mw in {
            exact = model.ground(contents(mw));
        }
        unbox_slice(heap, m);
        var w = json.writer(heap, 256);
        w = json.begin_object(heap, w);
        w = json.put_key(heap, w, "method");
        if use_bfgs {
            w = json.put_string(heap, w, "bfgs");
        } else if use_spsa {
            w = json.put_string(heap, w, "spsa");
        } else {
            w = json.put_string(heap, w, "nelder-mead");
        }
        w = json.put_key(heap, w, "layers");
        w = json.put_int(heap, w, layers);
        w = json.put_key(heap, w, "parameters");
        w = json.put_int(heap, w, count);
        w = json.put_key(heap, w, "exact");
        w = json.put_float(heap, w, exact);
        w = json.put_key(heap, w, "energy");
        w = json.put_float(heap, w, best);
        w = json.put_key(heap, w, "error");
        w = json.put_float(heap, w, best - exact);
        w = json.put_key(heap, w, "true_energy");
        w = json.put_float(heap, w, true_energy);
        w = json.put_key(heap, w, "true_error");
        w = json.put_float(heap, w, true_energy - exact);
        w = json.put_key(heap, w, "shots");
        var spent = 0;
        if shots > 0 {
            if use_bfgs {
                spent = gradients * (1 + 2 * count) * 2 * shots;
            } else {
                spent = evaluations * 2 * shots;
            }
        }
        w = json.put_int(heap, w, spent);
        w = json.put_key(heap, w, "evaluations");
        w = json.put_int(heap, w, evaluations);
        w = json.put_key(heap, w, "gradients");
        w = json.put_int(heap, w, gradients);
        w = json.put_key(heap, w, "restarts");
        w = json.put_int(heap, w, restarts);
        w = json.put_key(heap, w, "converged");
        w = json.put_bool(heap, w, converged);
        w = json.end_object(heap, w);
        let text = buffer.push(heap, json.finish(w), byte_of(10));
        borrow text as &tr in {
            buffer.write(io, tr);
        }
        buffer.drop(heap, text);
        if !converged {
            status = 1;
        }
    }
    return status;
}

fn main(world: World) -> [] int {
    let Split { io, ffi, fs, heap, args, net, clock, signals, exec } = split(world);
    release(ffi);
    release(fs);
    release(net);
    release(signals);
    var status = 0;
    borrow args as &g in {
        borrow exec as &x in {
            borrow clock as &c in {
                borrow mut heap as &!h in {
                    borrow mut io as &!i in {
                        status = command(h, i, x, c, g);
                    }
                }
            }
        }
    }
    release(args);
    release(exec);
    release(clock);
    release(heap);
    release(io);
    return status;
}
