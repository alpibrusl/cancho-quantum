module qc.dump;

import qc.gates;
import qc.measure;
import qc.state;
import std.fmt;
import std.io;
import std.math;

// The output records `qsim` prints, in one place so that the interpreter
// (`main.cho`) and the compiled circuits (`tests/circuits/`, generated by
// `scripts/qc_to_cho.py`) print byte-identical text.
//
// Floats are the shortest decimal that reads back to the same bits
// (`std.fmt.float_into`), so a reader recovers the exact double.

pub fn put_float[&i, &b](io: &!i Io, scratch: &!b [byte], x: float) -> [io_write] int {
    let k = fmt.float_into(scratch, x);
    return io.write_all(io, scratch[0..k]);
}

// `m <qubit> <bit>`
pub fn measurement[&i](io: &!i Io, q: int, bit: int) -> [io_write] int {
    io.write_all(io, "m ");
    io.print_int(io, q);
    io.write_all(io, " ");
    io.print_int(io, bit);
    return io.newline(io);
}

// `trig <cos> <sin>` of half of the angle `pi * num / den`.
pub fn trig[&i, &b](io: &!i Io, scratch: &!b [byte], num: int, den: int) -> [io_write] int {
    let half = gates.angle(num, den) * 0.5;
    io.write_all(io, "trig ");
    put_float(io, scratch, math.cos(half));
    io.write_all(io, " ");
    put_float(io, scratch, math.sin(half));
    return io.newline(io);
}

// `amp <index> <re> <im>` for every amplitude, in index order.
pub fn amplitudes[&i, &s, &b](io: &!i Io, st: &s [float], n: int, scratch: &!b [byte]) -> [io_write] int {
    var k = 0;
    while k < state.amplitudes_for(n) {
        io.write_all(io, "amp ");
        io.print_int(io, k);
        io.write_all(io, " ");
        put_float(io, scratch, st[2 * k]);
        io.write_all(io, " ");
        put_float(io, scratch, st[2 * k + 1]);
        io.newline(io);
        k = k + 1;
    }
    return 0;
}

// The same lines, only for the amplitudes whose probability `re^2 + im^2` is at least `min` (a `min` of 0 or less prints them all, which is `amplitudes`). Printing a float that is not short costs about 17 microseconds
// (`std.fmt` is exact Dragon4 on bignums: docs/benchmark.md), and a dense state of n qubits has 2^n of them.
pub fn amplitudes_above[&i, &s, &b](io: &!i Io, st: &s [float], n: int, scratch: &!b [byte], min: float) -> [io_write] int {
    var k = 0;
    while k < state.amplitudes_for(n) {
        if min <= 0.0 || st[2 * k] * st[2 * k] + st[2 * k + 1] * st[2 * k + 1] >= min {
            io.write_all(io, "amp ");
            io.print_int(io, k);
            io.write_all(io, " ");
            put_float(io, scratch, st[2 * k]);
            io.write_all(io, " ");
            put_float(io, scratch, st[2 * k + 1]);
            io.newline(io);
        }
        k = k + 1;
    }
    return 0;
}

// Sample `shots` outcomes (no collapse) and print one line per distinct
// outcome, in index order: `sample <bits> <count>`, the bits most significant
// qubit first. `shots` is at most 4096. Answers 0, or 2 if it is not.
pub fn samples[&i, &s, &r](io: &!i Io, st: &s [float], n: int, rng: &!r [int], shots: int) -> [io_write] int {
    if shots < 1 || shots > 4096 {
        return 2;
    }
    region a {
        let picks = alloc_slice[a](shots, 0);
        let bits = alloc_slice[a](24, byte_of(0));
        measure.sample(st, n, rng, picks);
        var k = 0;
        while k < shots {
            var j = k;
            while j < shots && picks[j] == picks[k] {
                j = j + 1;
            }
            io.write_all(io, "sample ");
            var q = n - 1;
            while q >= 0 {
                bits[n - 1 - q] = byte_of('0' + (picks[k] >> q & 1));
                q = q - 1;
            }
            io.write_all(io, bits[0..n]);
            io.write_all(io, " ");
            io.print_int(io, j - k);
            io.newline(io);
            k = j;
        }
    }
    return 0;
}
