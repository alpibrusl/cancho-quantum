module qc.density;

import qc.complex;
import qc.dump;
import qc.gates;
import qc.measure;
import qc.noise;
import qc.profile;
import qc.reader;
import qc.state;
import std.io;
import std.math;

// The exact way to simulate noise: keep the density matrix rho (2^n by 2^n)
// and apply each operation as rho -> U rho U^dagger, each channel as
// rho -> sum_k K rho K^dagger. No sampling, so one run is the answer that the
// trajectory method of `noise.cho` approaches only on average.
//
// The matrix is stored as a state vector of 2n qubits: entry rho[i][j] is the
// amplitude at index `i + j * 2^n`. Qubit q of the circuit is qubit q of the
// vector for the row index and qubit q + n for the column index, so U on the
// rows is the gate on qubit q, and U-conjugate on the columns is the
// *conjugated* gate on qubit q + n. That is all of it: every gate in `gates.cho`
// runs unchanged, on 2n qubits. This is why the limit is 10 qubits (2n = 20).
//
// Conjugating a gate: the real ones (H, X, Z, CX, CZ, SWAP, CCX, RY) are their own
// conjugate; S, T swap with S-dagger, T-dagger; Y is replaced by -Y's matrix;
// RX, RZ, P and CP flip the sign of their angle.

// Every channel here acts on the 2 x 2 block of rho that qubit `q` selects (rows with bit q, columns with bit q + n)
// as a real linear map, and the same map on its real and imaginary parts, so one pass over the matrix does it:
//
//     x00' = a x00 + b x11        x01' = e x01 + f x10
//     x11' = c x11 + d x00        x10' = e x10 + f x01
//
// (x_rc is the entry at row bit r, column bit c.) The maps, with sum_k K rho K^dagger worked out:
//     bit flip p      a = c = e = 1 - p,  b = d = f = p
//     phase flip p    a = c = 1, b = d = f = 0,  e = 1 - 2p
//     depolarizing p  a = c = 1 - 2p/3,  b = d = 2p/3,  e = 1 - 4p/3,  f = 0     (rho -> (1 - 4p/3) rho + (2p/3) tr(block) I)
//     amplitude damping g   a = 1, b = g, c = 1 - g, d = 0, e = sqrt(1 - g), f = 0
fn mix1[&s](st: &!s [float], n: int, q: int, a: float, b: float, c: float, d: float, e: float, f: float) -> [] int {
    gates.in_range(n, q);
    let rbit = 1 << q;
    let cbit = 1 << q + n;
    let total = state.amplitudes_for(2 * n);
    var i = 0;
    while i < total {
        if i & rbit == 0 && i & cbit == 0 {
            var part = 0;
            while part < 2 {
                let k00 = 2 * i + part;
                let k10 = 2 * (i | rbit) + part;
                let k01 = 2 * (i | cbit) + part;
                let k11 = 2 * (i | rbit | cbit) + part;
                let x00 = st[k00];
                let x01 = st[k01];
                let x10 = st[k10];
                let x11 = st[k11];
                st[k00] = a * x00 + b * x11;
                st[k11] = c * x11 + d * x00;
                st[k01] = e * x01 + f * x10;
                st[k10] = e * x10 + f * x01;
                part = part + 1;
            }
        }
        i = i + 1;
    }
    return 0;
}

// Apply a one-qubit channel with probability (or decay) `p` to qubit `q`.
fn channel[&s](st: &!s [float], n: int, q: int, w: int, p: float) -> [] int {
    if w == 27423402228804976 {
        // amplitude damping
        mix1(st, n, q, 1.0, p, 1.0 - p, 0.0, sqrt(1.0 - p), 0.0);
    } else if w == 27700496373148016 {
        mix1(st, n, q, 1.0 - p, p, 1.0 - p, p, 1.0 - p, p);
    } else if w == 31639965148735084 {
        mix1(st, n, q, 1.0, 0.0, 1.0, 0.0, 1.0 - 2.0 * p, 0.0);
    } else {
        mix1(st, n, q, 1.0 - 2.0 * p / 3.0, 2.0 * p / 3.0, 1.0 - 2.0 * p / 3.0, 2.0 * p / 3.0, 1.0 - 4.0 * p / 3.0, 0.0);
    }
    return 0;
}

// Idle for `ns` nanoseconds on qubit `q`: amplitude damping, then dephasing, as `noise.relax`.
fn relax[&s, &r](st: &!s [float], n: int, q: int, ns: int, rng: &r [int]) -> [] int {
    if ns > 0 && profile.has_coh(rng, q) {
        channel(st, n, q, 27423402228804976, profile.relax_gamma(rng, q, ns));
        let f = profile.relax_flip(rng, q, ns);
        if f > 0.0 {
            channel(st, n, q, 31639965148735084, f);
        }
    }
    return 0;
}

// Scheduling, as `noise.before2` and `noise.barrier`: the qubit that is free earlier idles until the other is.
fn before2[&s, &r](st: &!s [float], n: int, a: int, b: int, rng: &!r [int]) -> [] int {
    if profile.scheduled(rng) {
        let start = noise.max_int(profile.clock(rng, a), profile.clock(rng, b));
        relax(st, n, a, start - profile.clock(rng, a), rng);
        relax(st, n, b, start - profile.clock(rng, b), rng);
        profile.set_clock(rng, a, start);
        profile.set_clock(rng, b, start);
    }
    return 0;
}

fn barrier[&s, &r](st: &!s [float], n: int, rng: &!r [int]) -> [] int {
    if profile.scheduled(rng) {
        let end = profile.makespan(rng, n);
        var q = 0;
        while q < n {
            relax(st, n, q, end - profile.clock(rng, q), rng);
            profile.set_clock(rng, q, end);
            q = q + 1;
        }
    }
    return 0;
}

// Two-qubit depolarizing: rho -> (1 - p) rho + (p / 15) * sum over the 15 non-identity Pauli pairs of (P x Q) rho (P x Q).
// The 16 Pauli pairs together send a 4 x 4 block X to 4 tr(X) I, so the block becomes (1 - 16p/15) X + (4p/15) tr(X) I:
// the entries off the diagonal are scaled, those on it also get a share of the trace. One pass.
fn channel2[&s](st: &!s [float], n: int, a: int, b: int, p: float) -> [] int {
    gates.in_range(n, a);
    gates.in_range(n, b);
    let lam = 1.0 - 16.0 * p / 15.0;
    let share = 4.0 * p / 15.0;
    let abit = 1 << a;
    let bbit = 1 << b;
    let mask = abit | bbit | abit << n | bbit << n;
    let total = state.amplitudes_for(2 * n);
    var i = 0;
    while i < total {
        if i & mask == 0 {
            var part = 0;
            while part < 2 {
                // the diagonal of the block: row pair r equals column pair r
                var tr = 0.0;
                var r = 0;
                while r < 4 {
                    let row = (r & 1) * abit + r / 2 * bbit;
                    tr = tr + st[2 * (i + row + (row << n)) + part];
                    r = r + 1;
                }
                r = 0;
                while r < 4 {
                    var c = 0;
                    while c < 4 {
                        let row = (r & 1) * abit + r / 2 * bbit;
                        let col = (c & 1) * abit + c / 2 * bbit;
                        let k = 2 * (i + row + (col << n)) + part;
                        if r == c {
                            st[k] = lam * st[k] + share * tr;
                        } else {
                            st[k] = lam * st[k];
                        }
                        c = c + 1;
                    }
                    r = r + 1;
                }
                part = part + 1;
            }
        }
        i = i + 1;
    }
    return 0;
}

// A one-qubit gate on rho is the gate on the rows and its conjugate on the columns. Done as two passes over the whole
// matrix (what `gates.cho` does on the vector of 2n qubits) it streams the matrix twice; each 2 x 2 block (row bit r,
// column bit c: x_rc) is independent of the others, so these do both in one pass, with the same arithmetic in the same
// order, entry by entry, as the two passes: the result is bit for bit the same.

// diag(r0, r1) on the rows, diag(c0, c1) on the columns.
fn both_diagonal[&s](st: &!s [float], n: int, q: int, r0: complex.Complex, r1: complex.Complex, c0: complex.Complex, c1: complex.Complex) -> [] int {
    gates.in_range(n, q);
    let rbit = 1 << q;
    let cbit = 1 << q + n;
    let total = state.amplitudes_for(2 * n);
    var i = 0;
    while i < total {
        if i & rbit == 0 && i & cbit == 0 {
            state.put(st, i, complex.mul(complex.mul(state.get(st, i), r0), c0));
            state.put(st, i | cbit, complex.mul(complex.mul(state.get(st, i | cbit), r0), c1));
            state.put(st, i | rbit, complex.mul(complex.mul(state.get(st, i | rbit), r1), c0));
            state.put(st, i | rbit | cbit, complex.mul(complex.mul(state.get(st, i | rbit | cbit), r1), c1));
        }
        i = i + 1;
    }
    return 0;
}

// X on the rows and on the columns: (r, c) -> (1 - r, 1 - c).
fn both_x[&s](st: &!s [float], n: int, q: int) -> [] int {
    gates.in_range(n, q);
    let rbit = 1 << q;
    let cbit = 1 << q + n;
    let total = state.amplitudes_for(2 * n);
    var i = 0;
    while i < total {
        if i & rbit == 0 && i & cbit == 0 {
            let x00 = state.get(st, i);
            let x01 = state.get(st, i | cbit);
            state.put(st, i, state.get(st, i | rbit | cbit));
            state.put(st, i | cbit, state.get(st, i | rbit));
            state.put(st, i | rbit, x01);
            state.put(st, i | rbit | cbit, x00);
        }
        i = i + 1;
    }
    return 0;
}

// H on the rows and on the columns.
fn both_hadamard[&s](st: &!s [float], n: int, q: int) -> [] int {
    gates.in_range(n, q);
    let rbit = 1 << q;
    let cbit = 1 << q + n;
    let total = state.amplitudes_for(2 * n);
    let r = 1.0 / sqrt(2.0);
    var i = 0;
    while i < total {
        if i & rbit == 0 && i & cbit == 0 {
            let x00 = state.get(st, i);
            let x01 = state.get(st, i | cbit);
            let x10 = state.get(st, i | rbit);
            let x11 = state.get(st, i | rbit | cbit);
            let t00 = complex.scale(complex.add(x00, x10), r);
            let t10 = complex.scale(complex.sub(x00, x10), r);
            let t01 = complex.scale(complex.add(x01, x11), r);
            let t11 = complex.scale(complex.sub(x01, x11), r);
            state.put(st, i, complex.scale(complex.add(t00, t01), r));
            state.put(st, i | cbit, complex.scale(complex.sub(t00, t01), r));
            state.put(st, i | rbit, complex.scale(complex.add(t10, t11), r));
            state.put(st, i | rbit | cbit, complex.scale(complex.sub(t10, t11), r));
        }
        i = i + 1;
    }
    return 0;
}

// [[a, b], [c, d]] on the rows and [[a2, b2], [c2, d2]] on the columns.
fn both_unitary[&s](st: &!s [float], n: int, q: int, a: complex.Complex, b: complex.Complex, c: complex.Complex, d: complex.Complex, a2: complex.Complex, b2: complex.Complex, c2: complex.Complex, d2: complex.Complex) -> [] int {
    gates.in_range(n, q);
    let rbit = 1 << q;
    let cbit = 1 << q + n;
    let total = state.amplitudes_for(2 * n);
    var i = 0;
    while i < total {
        if i & rbit == 0 && i & cbit == 0 {
            let x00 = state.get(st, i);
            let x01 = state.get(st, i | cbit);
            let x10 = state.get(st, i | rbit);
            let x11 = state.get(st, i | rbit | cbit);
            let t00 = complex.add(complex.mul(a, x00), complex.mul(b, x10));
            let t10 = complex.add(complex.mul(c, x00), complex.mul(d, x10));
            let t01 = complex.add(complex.mul(a, x01), complex.mul(b, x11));
            let t11 = complex.add(complex.mul(c, x01), complex.mul(d, x11));
            state.put(st, i, complex.add(complex.mul(a2, t00), complex.mul(b2, t01)));
            state.put(st, i | cbit, complex.add(complex.mul(c2, t00), complex.mul(d2, t01)));
            state.put(st, i | rbit, complex.add(complex.mul(a2, t10), complex.mul(b2, t11)));
            state.put(st, i | rbit | cbit, complex.add(complex.mul(c2, t10), complex.mul(d2, t11)));
        }
        i = i + 1;
    }
    return 0;
}

// CX with control `a`, target `b` on the rows and on the columns (a + n, b + n): a permutation, so any order is exact.
fn both_cx[&s](st: &!s [float], n: int, a: int, b: int) -> [] int {
    gates.distinct(n, a, b);
    let crow = 1 << a;
    let ccol = 1 << a + n;
    let trow = 1 << b;
    let tcol = 1 << b + n;
    let total = state.amplitudes_for(2 * n);
    var i = 0;
    while i < total {
        if i & trow == 0 && i & tcol == 0 && (i & crow != 0 || i & ccol != 0) {
            var x00 = state.get(st, i);
            var x01 = state.get(st, i | tcol);
            var x10 = state.get(st, i | trow);
            var x11 = state.get(st, i | trow | tcol);
            if i & crow != 0 {
                let t0 = x00;
                let t1 = x01;
                x00 = x10;
                x01 = x11;
                x10 = t0;
                x11 = t1;
            }
            if i & ccol != 0 {
                let t0 = x00;
                let t1 = x10;
                x00 = x01;
                x10 = x11;
                x01 = t0;
                x11 = t1;
            }
            state.put(st, i, x00);
            state.put(st, i | tcol, x01);
            state.put(st, i | trow, x10);
            state.put(st, i | trow | tcol, x11);
        }
        i = i + 1;
    }
    return 0;
}

// One-qubit unitaries by word: the gate on the rows, its conjugate on the columns. The matrices are those of `gates.cho`.
fn gate1[&s](st: &!s [float], n: int, w: int, q: int, theta: float) -> [] int {
    gates.in_range(n, q);
    let one = complex.make(1.0, 0.0);
    let minus_one = complex.make(0.0 - 1.0, 0.0);
    let i = complex.make(0.0, 1.0);
    let minus_i = complex.make(0.0, 0.0 - 1.0);
    let o = complex.zero();
    if w == 104 {
        both_hadamard(st, n, q);
    } else if w == 120 {
        both_x(st, n, q);
    } else if w == 121 {
        both_unitary(st, n, q, o, minus_i, i, o, o, i, minus_i, o);
    } else if w == 122 {
        both_diagonal(st, n, q, one, minus_one, one, minus_one);
    } else if w == 115 {
        both_diagonal(st, n, q, one, i, one, minus_i);
    } else if w == 7562343 {
        both_diagonal(st, n, q, one, minus_i, one, i);
    } else if w == 116 {
        let a = gates.pi() / 4.0;
        both_diagonal(st, n, q, one, complex.make(math.cos(a), math.sin(a)), one, complex.make(math.cos(a), 0.0 - math.sin(a)));
    } else if w == 7627879 {
        let a = gates.pi() / 4.0;
        both_diagonal(st, n, q, one, complex.make(math.cos(a), 0.0 - math.sin(a)), one, complex.make(math.cos(a), math.sin(a)));
    } else if w == 29304 {
        let half = theta * 0.5;
        let half2 = (0.0 - theta) * 0.5;
        let c = complex.make(math.cos(half), 0.0);
        let m = complex.make(0.0, 0.0 - math.sin(half));
        let c2 = complex.make(math.cos(half2), 0.0);
        let m2 = complex.make(0.0, 0.0 - math.sin(half2));
        both_unitary(st, n, q, c, m, m, c, c2, m2, m2, c2);
    } else if w == 29305 {
        let half = theta * 0.5;
        let cs = math.cos(half);
        let sn = math.sin(half);
        let c = complex.make(cs, 0.0);
        let mn = complex.make(0.0 - sn, 0.0);
        let pn = complex.make(sn, 0.0);
        both_unitary(st, n, q, c, mn, pn, c, c, mn, pn, c);
    } else if w == 29306 {
        let half = theta * 0.5;
        let half2 = (0.0 - theta) * 0.5;
        both_diagonal(st, n, q, complex.make(math.cos(half), 0.0 - math.sin(half)), complex.make(math.cos(half), math.sin(half)), complex.make(math.cos(half2), 0.0 - math.sin(half2)), complex.make(math.cos(half2), math.sin(half2)));
    } else {
        both_diagonal(st, n, q, one, complex.make(math.cos(theta), math.sin(theta)), one, complex.make(math.cos(0.0 - theta), math.sin(0.0 - theta)));
    }
    return 0;
}

// Probability that qubit `q` reads 1: the sum of the diagonal entries with that bit set.
fn prob_one[&s](st: &s [float], n: int, q: int) -> [] float {
    var p = 0.0;
    var i = 0;
    while i < 1 << n {
        if i & 1 << q != 0 {
            p = p + st[2 * (i + (i << n))];
        }
        i = i + 1;
    }
    return p;
}

// Projective measurement of qubit `q`: draw an outcome, keep only the entries
// whose row and column both agree with it, and divide by its probability.
fn measure_q[&s, &r](st: &!s [float], n: int, q: int, rng: &!r [int]) -> [] int {
    let p1 = prob_one(st, n, q);
    let u = measure.next(rng);
    var outcome = 0;
    var p = 1.0 - p1;
    if u < p1 {
        outcome = 1;
        p = p1;
    }
    var i = 0;
    while i < 1 << n {
        var j = 0;
        while j < 1 << n {
            let idx = i + (j << n);
            var ri = 0;
            if i & 1 << q != 0 {
                ri = 1;
            }
            var cj = 0;
            if j & 1 << q != 0 {
                cj = 1;
            }
            if ri == outcome && cj == outcome {
                st[2 * idx] = st[2 * idx] / p;
                st[2 * idx + 1] = st[2 * idx + 1] / p;
            } else {
                st[2 * idx] = 0.0;
                st[2 * idx + 1] = 0.0;
            }
            j = j + 1;
        }
        i = i + 1;
    }
    return outcome;
}

// `rho <row> <col> <re> <im>` for every entry that is not exactly zero.
fn print_rho[&i, &s, &b](io: &!i Io, st: &s [float], n: int, scratch: &!b [byte]) -> [io_write] int {
    var i = 0;
    while i < 1 << n {
        var j = 0;
        while j < 1 << n {
            let idx = i + (j << n);
            if st[2 * idx] != 0.0 || st[2 * idx + 1] != 0.0 {
                io.write_all(io, "rho ");
                io.print_int(io, i);
                io.write_all(io, " ");
                io.print_int(io, j);
                io.write_all(io, " ");
                dump.put_float(io, scratch, st[2 * idx]);
                io.write_all(io, " ");
                dump.put_float(io, scratch, st[2 * idx + 1]);
                io.newline(io);
            }
            j = j + 1;
        }
        i = i + 1;
    }
    return 0;
}

// `probs`: `prob <bits> <p>` for each basis state with probability above zero.
fn print_probs[&i, &s, &b](io: &!i Io, st: &s [float], n: int, scratch: &!b [byte]) -> [io_write] int {
    var i = 0;
    while i < 1 << n {
        let p = st[2 * (i + (i << n))];
        if p > 0.0 {
            io.write_all(io, "prob ");
            var q = n - 1;
            while q >= 0 {
                putchar(io, '0' + (i >> q & 1));
                q = q - 1;
            }
            io.write_all(io, " ");
            dump.put_float(io, scratch, p);
            io.newline(io);
        }
        i = i + 1;
    }
    return 0;
}

// Run the operations after a `dm <n>` header. Answers 0, or 2 for a bad operation.
pub fn run[&i, &s, &r, &b, &q](io: &!i Io, st: &!s [float], n: int, rng: &!r [int], scratch: &!b [byte], quiet: &!q [int]) -> [io_read, io_write] int {
    var w = reader.read_word(io);
    while w >= 0 {
        var post1 = 0 - 1;
        var post2a = 0 - 1;
        var post2b = 0 - 1;
        if w == 104 || w == 120 || w == 121 || w == 122 || w == 115 || w == 116 || w == 7562343 || w == 7627879 {
            let q = reader.read_int(io);
            gate1(st, n, w, q, 0.0);
            post1 = q;
        } else if w == 29304 || w == 29305 || w == 29306 || w == 112 {
            let a = reader.read_int(io);
            let num = reader.read_int(io);
            let den = reader.read_int(io);
            gate1(st, n, w, a, gates.angle(num, den));
            post1 = a;
        } else if w == 25464 {
            let a = reader.read_int(io);
            let b = reader.read_int(io);
            gates.distinct(n, a, b);
            before2(st, n, a, b, rng);
            both_cx(st, n, a, b);
            post2a = a;
            post2b = b;
        } else if w == 25466 {
            let a = reader.read_int(io);
            let b = reader.read_int(io);
            gates.distinct(n, a, b);
            before2(st, n, a, b, rng);
            gates.cz(st, 2 * n, a, b);
            gates.cz(st, 2 * n, a + n, b + n);
            post2a = a;
            post2b = b;
        } else if w == 1937203568 {
            let a = reader.read_int(io);
            let b = reader.read_int(io);
            gates.distinct(n, a, b);
            before2(st, n, a, b, rng);
            gates.swap(st, 2 * n, a, b);
            gates.swap(st, 2 * n, a + n, b + n);
            post2a = a;
            post2b = b;
        } else if w == 6513528 {
            let a = reader.read_int(io);
            let b = reader.read_int(io);
            let c2 = reader.read_int(io);
            gates.distinct(n, a, b);
            gates.distinct(n, a, c2);
            gates.distinct(n, b, c2);
            gates.ccx(st, 2 * n, a, b, c2);
            gates.ccx(st, 2 * n, a + n, b + n, c2 + n);
        } else if w == 25456 {
            let a = reader.read_int(io);
            let b = reader.read_int(io);
            let num = reader.read_int(io);
            let den = reader.read_int(io);
            gates.distinct(n, a, b);
            before2(st, n, a, b, rng);
            gates.cp(st, 2 * n, a, b, gates.angle(num, den));
            gates.cp(st, 2 * n, a + n, b + n, 0.0 - gates.angle(num, den));
            post2a = a;
            post2b = b;
        } else if w == 27700496373148016 || w == 31639965148735084 || w == 431198596972 || w == 27423402228804976 {
