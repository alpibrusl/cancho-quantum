            profile.set_clock(rng, post2a, profile.clock(rng, post2a) + profile.dur2(rng, post2a, post2b));
            profile.set_clock(rng, post2b, profile.clock(rng, post2b) + profile.dur2(rng, post2a, post2b));
        }
        w = reader.read_word(io);
    }
    barrier(st, n, rng);
    if quiet[0] == 0 {
        print_rho(io, st, n, scratch);
    }
    return 0;
}
