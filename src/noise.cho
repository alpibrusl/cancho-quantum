module qc.noise;

import qc.complex;
import qc.gates;
import qc.measure;
import qc.state;

// Noise by quantum trajectories. The state stays a pure vector. Each channel
// is applied as one randomly chosen Kraus operator, chosen with the
// probability the channel gives it and renormalised, so the average of
// |psi><psi| over many runs is the density matrix the channel produces
// (`scripts/check_noise.py` tests exactly that against a density-matrix
// calculation). One run is one sample of what a noisy machine did.
//
// Every channel draws exactly one number from the sampler, whether or not it
// fires, so adding a channel with probability 0 does not move any later draw.
//
// A probability is `num / den`, as angles are `pi * num / den`: a ratio of
// integers rounds the same way here and in the reference.

pub fn prob(num: int, den: int) -> [] float {
    return float_of(num) / float_of(den);
}

// With probability `p`, flip the qubit (X).
pub fn bitflip[&s, &r](st: &!s [float], n: int, q: int, p: float, rng: &!r [int]) -> [] int {
    let u = measure.next(rng);
    if u < p {
        gates.x(st, n, q);
    }
    return 0;
}

// With probability `p`, flip the phase (Z).
pub fn phaseflip[&s, &r](st: &!s [float], n: int, q: int, p: float, rng: &!r [int]) -> [] int {
    let u = measure.next(rng);
    if u < p {
        gates.z(st, n, q);
    }
    return 0;
}

// Depolarizing: with probability `p`, one of X, Y, Z, each equally likely
// (so each has probability p/3). One draw: `u < p` fires it, and `u / p`,
// which is uniform on [0, 1) when it fires, picks the Pauli.
pub fn depol[&s, &r](st: &!s [float], n: int, q: int, p: float, rng: &!r [int]) -> [] int {
    let u = measure.next(rng);
    if u < p {
        let k = u / p;
        if k < 1.0 / 3.0 {
            gates.x(st, n, q);
        } else if k < 2.0 / 3.0 {
            gates.y(st, n, q);
        } else {
            gates.z(st, n, q);
        }
    }
    return 0;
}

// Amplitude damping with decay probability `gamma`: the qubit falls from 1
// to 0. Kraus operators K0 = diag(1, sqrt(1 - gamma)) and
// K1 = [[0, sqrt(gamma)], [0, 0]]. The jump K1 happens with probability
// gamma * P(qubit is 1); otherwise K0 acts. Either way the state is
// renormalised.
pub fn ampdamp[&s, &r](st: &!s [float], n: int, q: int, gamma: float, rng: &!r [int]) -> [] int {
    gates.in_range(n, q);
    let p1 = gamma * measure.prob_one(st, n, q);
    let u = measure.next(rng);
    let bit = 1 << q;
    let total = state.amplitudes_for(n);
    var i = 0;
    if u < p1 {
        // Jump: |1> becomes |0>, scaled so the state has norm 1.
        let k = sqrt(gamma) / sqrt(p1);
        while i < total {
            if i & bit == 0 {
                state.put(st, i, complex.scale(state.get(st, i | bit), k));
                state.put(st, i | bit, complex.zero());
            }
            i = i + 1;
        }
    } else {
        // No jump: the |1> amplitudes shrink by sqrt(1 - gamma), and the whole
        // state is divided by sqrt(1 - p1).
        let keep = 1.0 / sqrt(1.0 - p1);
        let shrink = sqrt(1.0 - gamma) * keep;
        while i < total {
            if i & bit == 0 {
                state.put(st, i, complex.scale(state.get(st, i), keep));
            } else {
                state.put(st, i, complex.scale(state.get(st, i), shrink));
            }
            i = i + 1;
        }
    }
    return 0;
}
