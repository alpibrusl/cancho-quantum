module qc.qubit;

import qc.gates;
import qc.measure;
import qc.noise;

// The linear qubit layer (M2, `docs/qubit-types.md`). A `Qubit` is a
// `res`: it cannot be copied, it cannot be dropped, and the only
// function here that ends one is `measure`. Gates borrow it.
//
//   * `h`, `x`, `z`, `s`, `t`, `rz` take the qubit as `&!`: it is
//     modified in place and still owned afterwards.
//   * `cx` and `cz` take the control as `&` (read, not modified) and the
//     target as `&!`.
//   * `measure` takes the qubit by value, so a measured qubit is gone.
//
// A qubit is an index into a state vector that the caller threads through
// every call, and it remembers the qubit count `n` of that vector so a
// gate needs no extra argument. What the checker enforces and what it
// does not is `docs/qubit-types.md` §4; the short version is that
// ownership is checked here and *distinctness of two operands* is checked
// at run time, in `gates.cx`.
//
// `fresh` is the only constructor this module offers, but not the only
// one that exists: a `pub res struct` can be built and taken apart from
// any module (`docs/m2-results.md`, R2), so "only `fresh` mints qubits"
// is a convention.

pub res struct Qubit {
    idx: int,
    n: int,
}

// Qubit `i` of an `n`-qubit state. The caller promises each `i` is used
// once; nothing checks that, because the state vector is not a linear
// resource and a `Qubit` cannot see it.
pub fn fresh(n: int, i: int) -> [] Qubit {
    return Qubit { idx: i, n: n };
}

pub fn h[&a, &s](q: &!a Qubit, st: &!s [float]) -> [] int {
    return gates.h(st, q.n, q.idx);
}

pub fn x[&a, &s](q: &!a Qubit, st: &!s [float]) -> [] int {
    return gates.x(st, q.n, q.idx);
}

pub fn z[&a, &s](q: &!a Qubit, st: &!s [float]) -> [] int {
    return gates.z(st, q.n, q.idx);
}

pub fn s[&a, &s](q: &!a Qubit, st: &!s [float]) -> [] int {
    return gates.s(st, q.n, q.idx);
}

pub fn t[&a, &s](q: &!a Qubit, st: &!s [float]) -> [] int {
    return gates.t(st, q.n, q.idx);
}

pub fn rz[&a, &s](q: &!a Qubit, st: &!s [float], theta: float) -> [] int {
    return gates.rz(st, q.n, q.idx, theta);
}

// Control is read, target is written. Both must belong to one state
// vector, and be different qubits: `gates.cx` traps on `ctl.idx ==
// tgt.idx`, the check the type system cannot make.
pub fn cx[&c, &t, &s](ctl: &c Qubit, tgt: &!t Qubit, st: &!s [float]) -> [] int {
    return gates.cx(st, ctl.n, ctl.idx, tgt.idx);
}

pub fn cz[&c, &t, &s](ctl: &c Qubit, tgt: &!t Qubit, st: &!s [float]) -> [] int {
    return gates.cz(st, ctl.n, ctl.idx, tgt.idx);
}

pub fn y[&a, &s](q: &!a Qubit, st: &!s [float]) -> [] int {
    return gates.y(st, q.n, q.idx);
}

pub fn sdg[&a, &s](q: &!a Qubit, st: &!s [float]) -> [] int {
    return gates.sdg(st, q.n, q.idx);
}

pub fn tdg[&a, &s](q: &!a Qubit, st: &!s [float]) -> [] int {
    return gates.tdg(st, q.n, q.idx);
}

pub fn rx[&a, &s](q: &!a Qubit, st: &!s [float], theta: float) -> [] int {
    return gates.rx(st, q.n, q.idx, theta);
}

pub fn ry[&a, &s](q: &!a Qubit, st: &!s [float], theta: float) -> [] int {
    return gates.ry(st, q.n, q.idx, theta);
}

pub fn p[&a, &s](q: &!a Qubit, st: &!s [float], lambda: float) -> [] int {
    return gates.p(st, q.n, q.idx, lambda);
}

// Controlled phase: the control is read, the target is written.
pub fn cp[&c, &t, &s](ctl: &c Qubit, tgt: &!t Qubit, st: &!s [float], lambda: float) -> [] int {
    return gates.cp(st, ctl.n, ctl.idx, tgt.idx, lambda);
}

// SWAP changes both qubits, so both are `&!`. Two borrows of one qubit at
// once are refused (`borrow-conflict`); the same `&!` passed twice is not
// (`tests/accept/swap_same_handle.cho`), and `gates.swap` traps on it.
pub fn swap[&a, &b, &s](q: &!a Qubit, r: &!b Qubit, st: &!s [float]) -> [] int {
    return gates.swap(st, q.n, q.idx, r.idx);
}

// Toffoli: two controls read, one target written.
pub fn ccx[&c1, &c2, &t, &s](ctl1: &c1 Qubit, ctl2: &c2 Qubit, tgt: &!t Qubit, st: &!s [float]) -> [] int {
    return gates.ccx(st, ctl1.n, ctl1.idx, ctl2.idx, tgt.idx);
}

// Noise acts on a qubit in place, so it takes the qubit `&!`. It does not end
// the qubit and does not change what the checker enforces: a noisy qubit is
// still a `res`. The probability is `num / den`.
pub fn depol[&a, &s, &r](q: &!a Qubit, st: &!s [float], rng: &!r [int], num: int, den: int) -> [] int {
    return noise.depol(st, q.n, q.idx, noise.prob(num, den), rng);
}

pub fn bitflip[&a, &s, &r](q: &!a Qubit, st: &!s [float], rng: &!r [int], num: int, den: int) -> [] int {
    return noise.bitflip(st, q.n, q.idx, noise.prob(num, den), rng);
}

pub fn phaseflip[&a, &s, &r](q: &!a Qubit, st: &!s [float], rng: &!r [int], num: int, den: int) -> [] int {
    return noise.phaseflip(st, q.n, q.idx, noise.prob(num, den), rng);
}

pub fn ampdamp[&a, &s, &r](q: &!a Qubit, st: &!s [float], rng: &!r [int], num: int, den: int) -> [] int {
    return noise.ampdamp(st, q.n, q.idx, noise.prob(num, den), rng);
}

// Consumes the qubit and answers the classical bit. The bit is `int`,
// which is `val`: copy it, branch on it, drop it.
pub fn measure[&s, &r](q: Qubit, st: &!s [float], rng: &!r [int]) -> [] int {
    let Qubit { idx, n } = q;
    return measure.measure(st, n, idx, rng);
}
