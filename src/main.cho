// `qsim` — run a circuit read from standard input on the state-vector
// simulator and print the final amplitudes.
//
// The input is one operation per line, so a circuit is data that can be
// hashed and checked in beside its reference output (`tests/diff/`):
//
//     n 3            qubit count; must come first
//     h 0            H, X, Z, S, T on qubit 0
//     cx 0 1         CNOT (control, target); `cz` likewise
//     rz 2 1 4       RZ on qubit 2 by theta = pi * 1 / 4
//     seed 42        reseed the sampler
//     m 1            measure qubit 1 and collapse
//     trig 1 4       print cos and sin of theta/2, theta = pi * 1 / 4
//     y sdg tdg swap ccx rx ry p cp   more gates (see docs/features-results.md); rx ry p take
//                    `q num den`, cp takes `a b num den`, swap `a b`, ccx `c1 c2 t`
//     bitflip|phaseflip|depol|ampdamp q num den   noise with probability num/den (docs/noise-results.md)
//     depol2 a b num den   two-qubit depolarizing: one of the 15 non-identity Pauli pairs
//     readout num den  each measured or sampled bit is reported flipped with probability num/den
//     model1 num den   depolarizing noise after every one-qubit gate; model2 for two-qubit gates (num 0: off)
//     coher q T1 T2    idle noise: this qubit relaxes (nanoseconds, T2 <= 2 T1); time1 ns, time2 ns set a gate's
//                    duration, and each gate qubit relaxes for it (dur1 q ns, dur2 a b ns: one qubit's or pair's own);
//                    `sched` starts every gate as soon as its qubits are free, so a qubit that waits for another decays too; `barrier` waits for all wait q ns idles a qubit (docs/idle-noise.md)
//     sample 1000    draw 1000 outcomes from the state (no collapse), print counts
//     quiet          print no `amp` lines (for timing the gates, not the printer)
//
// An angle is `pi * num / den` evaluated in that order, so the reference
// script can compute the identical double. Output, one record per line:
//
//     m <qubit> <bit>        for each measurement, as it happens
//     trig <cos> <sin>
//     amp <index> <re> <im>  for each amplitude, in index order
//
// A circuit that starts `dm <n>` instead of `n <count>` is run on the density matrix
// (exact noise, at most 10 qubits): `purity`, `trace`, `probs` print its properties.
// A file that starts with `OPENQASM` is read as OpenQASM 2.0 instead (`qasm.cho`); for those, `--quiet` prints no amplitudes and `--threshold P` only those whose probability is at least P (printing a
// 17-digit float costs about 15 microseconds, and a dense state has 2^n of them: docs/benchmark.md).
//
// Floats are the shortest decimal that reads back to the same bits
// (`std.fmt.float_into`), so the reader recovers the exact double.

import qc.density;
import qc.dump;
import qc.gates;
import qc.noise;
import qc.profile;
import qc.qasm;
import qc.reader;
import qc.measure;
import qc.state;
import std.bytes;
import std.io;

// Run every operation on the state and answer the number executed.
fn interpret[&i, &s, &r, &b](io: &!i Io, st: &!s [float], n: int, rng: &!r [int], scratch: &!b [byte]) -> [io_read, io_write] int {
    var ops = 0;
    var w = reader.read_word(io);
    while w >= 0 {
        // The gate this operation was, for the gate-noise model: -1 when it was not one.
        var post1 = 0 - 1;
        var post2a = 0 - 1;
        var post2b = 0 - 1;
        if w == 104 {
            let q = reader.read_int(io);
            gates.h(st, n, q);
            post1 = q;
        } else if w == 120 {
            let q = reader.read_int(io);
            gates.x(st, n, q);
            post1 = q;
        } else if w == 122 {
            let q = reader.read_int(io);
            gates.z(st, n, q);
            post1 = q;
        } else if w == 115 {
            let q = reader.read_int(io);
            gates.s(st, n, q);
            post1 = q;
        } else if w == 116 {
            let q = reader.read_int(io);
            gates.t(st, n, q);
            post1 = q;
        } else if w == 25464 {
            let c = reader.read_int(io);
            let t = reader.read_int(io);
            noise.before2(st, n, c, t, rng);
            gates.cx(st, n, c, t);
            post2a = c;
            post2b = t;
        } else if w == 25466 {
            let a = reader.read_int(io);
            let b = reader.read_int(io);
            noise.before2(st, n, a, b, rng);
            gates.cz(st, n, a, b);
            post2a = a;
            post2b = b;
        } else if w == 29306 {
            let q = reader.read_int(io);
            let num = reader.read_int(io);
            let den = reader.read_int(io);
            gates.rz(st, n, q, gates.angle(num, den));
            post1 = q;
        } else if w == 1936024932 {
            rng[0] = reader.read_int(io);
        } else if w == 109 {
            let q = reader.read_int(io);
            let bit = measure.measure(st, n, q, rng);
            dump.measurement(io, q, noise.readout(bit, q, rng));
        } else if w == 121 {
            let q = reader.read_int(io);
            gates.y(st, n, q);
            post1 = q;
        } else if w == 7562343 {
            let q = reader.read_int(io);
            gates.sdg(st, n, q);
            post1 = q;
        } else if w == 7627879 {
            let q = reader.read_int(io);
            gates.tdg(st, n, q);
            post1 = q;
        } else if w == 1937203568 {
            let a = reader.read_int(io);
            let b = reader.read_int(io);
            noise.before2(st, n, a, b, rng);
            gates.swap(st, n, a, b);
            post2a = a;
            post2b = b;
        } else if w == 6513528 {
            let c1 = reader.read_int(io);
            let c2 = reader.read_int(io);
            let t = reader.read_int(io);
            gates.ccx(st, n, c1, c2, t);
        } else if w == 29304 || w == 29305 || w == 112 {
            let q = reader.read_int(io);
            let num = reader.read_int(io);
            let den = reader.read_int(io);
            if w == 29304 {
                gates.rx(st, n, q, gates.angle(num, den));
            } else if w == 29305 {
                gates.ry(st, n, q, gates.angle(num, den));
            } else {
                gates.p(st, n, q, gates.angle(num, den));
            }
            post1 = q;
        } else if w == 25456 {
            let a = reader.read_int(io);
            let b = reader.read_int(io);
            let num = reader.read_int(io);
            let den = reader.read_int(io);
            noise.before2(st, n, a, b, rng);
            gates.cp(st, n, a, b, gates.angle(num, den));
            post2a = a;
            post2b = b;
        } else if w == 27700496373148016 || w == 31639965148735084 || w == 431198596972 || w == 27423402228804976 {
            let q = reader.read_int(io);
            let num = reader.read_int(io);
            let den = reader.read_int(io);
            let p = noise.prob(num, den);
            if w == 27700496373148016 {
                noise.bitflip(st, n, q, p, rng);
            } else if w == 31639965148735084 {
                noise.phaseflip(st, n, q, p, rng);
            } else if w == 431198596972 {
                noise.depol(st, n, q, p, rng);
            } else {
                noise.ampdamp(st, n, q, p, rng);
            }
        } else if w == 126862285106277 {
            noise.barrier(st, n, rng);
            if dump.samples(io, st, n, rng, reader.read_int(io)) != 0 {
                return 0 - 1;
            }
        } else if w == 110386840824882 {
            let a = reader.read_int(io);
            let b = reader.read_int(io);
            let num = reader.read_int(io);
            let den = reader.read_int(io);
            noise.depol2(st, n, a, b, noise.prob(num, den), rng);
        } else if w == 32199616316274036 || w == 120325193165873 || w == 120325193165874 {
            // `readout`, `model1`, `model2`: a probability num/den kept in the sampler's slots.
            let num = reader.read_int(io);
            let den = reader.read_int(io);
            if den < 1 || num < 0 || num > den {
                return 0 - 1;
            }
            var slot = 2;
            if w == 120325193165873 {
                slot = 4;
            } else if w == 120325193165874 {
                slot = 6;
            }
            rng[slot] = num;
            rng[slot + 1] = den;
        } else if w == 29099075143034226 {
            let q = reader.read_int(io);
            let num = reader.read_int(io);
            let den = reader.read_int(io);
            if q < 0 || q >= 20 || den < 1 || num < 0 || num > den {
                return 0 - 1;
            }
            profile.set_g1(rng, q, num, den);
        } else if w == 29099075143099762 {
            let a = reader.read_int(io);
            let b = reader.read_int(io);
            let num = reader.read_int(io);
            let den = reader.read_int(io);
            if a < 0 || a >= 20 || b < 0 || b >= 20 || a == b || den < 1 || num < 0 || num > den {
                return 0 - 1;
            }
            profile.set_g2(rng, a, b, num, den);
        } else if w == 32199616315617906 {
            let q = reader.read_int(io);
            let n01 = reader.read_int(io);
            let d01 = reader.read_int(io);
            let n10 = reader.read_int(io);
            let d10 = reader.read_int(io);
            if q < 0 || q >= 20 || d01 < 1 || n01 < 0 || n01 > d01 || d10 < 1 || n10 < 0 || n10 > d10 {
                return 0 - 1;
            }
            profile.set_ro(rng, q, n01, d01, n10, d10);
        } else if w == 427070874994 {
            // `coher q T1 T2` (nanoseconds; 0 < T1, 0 < T2 <= 2 T1): this qubit relaxes while it idles.
            let q = reader.read_int(io);
            let t1 = reader.read_int(io);
            let t2 = reader.read_int(io);
            if q < 0 || q >= 20 || t1 < 1 || t2 < 1 || t2 > 2 * t1 {
                return 0 - 1;
            }
            profile.set_coh(rng, q, t1, t2);
        } else if w == 499984983345 || w == 499984983346 {
            // `time1 ns`, `time2 ns`: how long a one- or two-qubit gate takes; each gate qubit then relaxes.
            let ns = reader.read_int(io);
            if ns < 0 {
                return 0 - 1;
            }
            if w == 499984983345 {
                profile.set_time(rng, 968, ns);
            } else {
                profile.set_time(rng, 969, ns);
            }
        } else if w == 1685418545 || w == 1685418546 {
            // `dur1 q ns`, `dur2 a b ns`: one qubit's or one pair's own gate time.
            let a = reader.read_int(io);
            if w == 1685418545 {
                let ns = reader.read_int(io);
                if a < 0 || a >= 20 || ns < 0 {
                    return 0 - 1;
                }
                profile.set_dur1(rng, a, ns);
            } else {
                let b = reader.read_int(io);
                let ns = reader.read_int(io);
                if a < 0 || a >= 20 || b < 0 || b >= 20 || a == b || ns < 0 {
                    return 0 - 1;
                }
                profile.set_dur2(rng, a, b, ns);
            }
        } else if w == 495589025124 {
            rng[1410] = 1;
        } else if w == 27691691891320178 {
            noise.barrier(st, n, rng);
        } else if w == 2002872692 {
            let q = reader.read_int(io);
            let ns = reader.read_int(io);
            if q < 0 || q >= n || ns < 0 {
                return 0 - 1;
            }
            noise.relax(st, n, q, ns, rng);
            profile.set_clock(rng, q, profile.clock(rng, q) + ns);
        } else if w == 487301145972 {
            rng[1] = 1;
        } else if w == 1953655143 {
            let num = reader.read_int(io);
            let den = reader.read_int(io);
            dump.trig(io, scratch, num, den);
        } else {
            return 0 - 1;
        }
        if post1 >= 0 {
            noise.after1(st, n, post1, rng);
        }
        if post2a >= 0 {
            noise.after2(st, n, post2a, post2b, rng);
        }
        ops = ops + 1;
        w = reader.read_word(io);
    }
    return ops;
}

// The circuit in the `.qc` text format, after its `n <count>` header.
fn run_qc[&h, &i](heap: &!h Heap, io: &!i Io, n: int) -> [heap, io_read, io_write] int {
    if n < 1 || n > 20 {
        return 2;
    }
    let amp = box_slice(heap, state.floats_for(n), 0.0);
    var status = 0;
    region r {
        // Slot 0 is the sampler's state; slot 1 is 1 after `quiet`; slots 2 to 7 hold
        // the readout, one-qubit-gate and two-qubit-gate noise probabilities as
        // numerator and denominator (numerator 0: off).
        let rng = alloc_slice[r](profile.size(), 0);
        profile.init(rng, 88172645463325252);
        let scratch = alloc_slice[r](24, byte_of(0));
        borrow mut amp as &!w in {
            let st = contents(w);
            state.start(st);
            if interpret(io, st, n, rng, scratch) < 0 {
                status = 2;
            } else {
                noise.barrier(st, n, rng);
            }
            if rng[1] == 0 && status == 0 {
                dump.amplitudes(io, st, n, scratch);
            }
        }
    }
    unbox_slice(heap, amp);
    return status;
}

// An OpenQASM 2.0 circuit, after its `OPENQASM` word. The register size is not
// known until `qreg`, so the vector is allocated for 20 qubits: a zero-filled
// block that costs nothing until a gate touches it.
fn run_qasm[&h, &i](heap: &!h Heap, io: &!i Io, threshold: float) -> [heap, io_read, io_write] int {
    let amp = box_slice(heap, state.floats_for(20), 0.0);
    let lbox = box_slice(heap, 41000, 0);
    var status = 0;
    region r {
        let rng = alloc_slice[r](1, 88172645463325252);
        let scratch = alloc_slice[r](24, byte_of(0));
        let qubits = alloc_slice[r](16, 0);
        borrow mut amp as &!w in {
            let st = contents(w);
            state.start(st);
            borrow mut lbox as &!lw in {
                status = qasm.run(io, st, qubits, rng, scratch, contents(lw));
            }
            if status == 0 && qubits[0] > 0 {
                dump.amplitudes_above(io, st, qubits[0], scratch, threshold);
            }
        }
    }
    unbox_slice(heap, amp);
    unbox_slice(heap, lbox);
    return status;
}

// A density-matrix circuit, after its `dm <n>` header (`density.cho`). The matrix of
// n qubits is a vector of 2n, so n is at most 10; every channel is applied in place.
fn run_dm[&h, &i](heap: &!h Heap, io: &!i Io, n: int) -> [heap, io_read, io_write] int {
    if n < 1 || n > 10 {
        return 2;
    }
    let size = state.floats_for(2 * n);
    let amp = box_slice(heap, size, 0.0);
    var status = 0;
    region r {
        let rng = alloc_slice[r](profile.size(), 0);
        profile.init(rng, 88172645463325252);
        let scratch = alloc_slice[r](24, byte_of(0));
        let quiet = alloc_slice[r](1, 0);
        quiet[0] = 0;
        borrow mut amp as &!w in {
            let st = contents(w);
            st[0] = 1.0;
            status = density.run(io, st, n, rng, scratch, quiet);
        }
    }
    unbox_slice(heap, amp);
    return status;
}

fn run[&h, &i](heap: &!h Heap, io: &!i Io, threshold: float) -> [heap, io_read, io_write] int {
    let head = reader.read_word(io);
    if head == 110 {
        return run_qc(heap, io, reader.read_int(io));
    }
    if head == 25709 {
        return run_dm(heap, io, reader.read_int(io));
    }
    if head == 22324781757055315 {
        return run_qasm(heap, io, threshold);
    }
    return 2;
}

fn main(world: World) -> [] int {
    let Split { io, ffi, fs, heap, args } = split(world);
    release(ffi);
    release(fs);
    var status = 0;
    // `--quiet` prints no amplitudes of an OpenQASM program, `--threshold P` only those whose probability is at least P (default: all, as ever)
    var threshold = 0.0;
    var refused = false;
    borrow args as &g in {
        var k = 1;
        while k < arg_count(g) {
            if bytes.equal(arg(g, k), "--quiet") {
                threshold = 2.0;
                k = k + 1;
            } else if bytes.equal(arg(g, k), "--threshold") && k + 1 < arg_count(g) {
                let (ok, v) = reader.parse_float(arg(g, k + 1));
                if !ok || v < 0.0 || v > 1.0 {
                    refused = true;
                }
                threshold = v;
                k = k + 2;
            } else {
                refused = true;
                k = arg_count(g);
            }
        }
    }
    release(args);
    borrow mut io as &!io in {
        if refused {
            io.error_all(io, "qsim: the arguments are --quiet and --threshold P (0 to 1), both for OpenQASM programs\n");
            status = 2;
        }
    }
    if status == 0 {
        borrow mut heap as &!h in {
            borrow mut io as &!i in {
                status = run(h, i, threshold);
            }
        }
    }
    release(heap);
    release(io);
    return status;
}
