module qc.complex;

// A complex number as two floats. cancho has no complex type in `std`
// (`docs/qubit-types.md` §9 of the idea doc), so this is the whole of it:
// a `val struct`, copied freely, with the four operations a state-vector
// simulator needs.
//
// Nothing here is rounded differently from the textbook formula. `mul`
// is `(a+bi)(c+di) = (ac - bd) + (ad + bc)i` in that order, which is
// what the reference implementation computes, so a difference between
// the two is a difference of the gates and not of this file.

pub val struct Complex {
    re: float,
    im: float,
}

pub fn make(re: float, im: float) -> [] Complex {
    return Complex { re: re, im: im };
}

pub fn zero() -> [] Complex {
    return Complex { re: 0.0, im: 0.0 };
}

pub fn add(a: Complex, b: Complex) -> [] Complex {
    return Complex { re: a.re + b.re, im: a.im + b.im };
}

pub fn sub(a: Complex, b: Complex) -> [] Complex {
    return Complex { re: a.re - b.re, im: a.im - b.im };
}

pub fn mul(a: Complex, b: Complex) -> [] Complex {
    return Complex { re: a.re * b.re - a.im * b.im, im: a.re * b.im + a.im * b.re };
}

pub fn scale(a: Complex, k: float) -> [] Complex {
    return Complex { re: a.re * k, im: a.im * k };
}

// |a|^2, the probability weight of an amplitude.
pub fn norm_sqr(a: Complex) -> [] float {
    return a.re * a.re + a.im * a.im;
}
