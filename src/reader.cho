module qc.reader;

import std.io;
import std.json;

// The token reader shared by the state-vector interpreter (`main.cho`) and the
// density-matrix interpreter (`density.cho`).

pub fn is_space(c: int) -> [] bool {
    return c == 32 || c == 10 || c == 13 || c == 9;
}

// Skip white space, then answer the next token's characters packed
// big-endian into an int ("cx" is 'c' * 256 + 'x'), or -1 at the end.
pub fn read_word[&i](io: &!i Io) -> [io_read] int {
    var c = getchar(io);
    while c >= 0 && is_space(c) {
        c = getchar(io);
    }
    if c < 0 {
        return 0 - 1;
    }
    var w = 0;
    var count = 0;
    while c >= 0 && !is_space(c) {
        // Only the first seven characters are kept, so a longer word (such as
        // `OPENQASM`) cannot overflow the packed int.
        if count < 7 {
            w = w * 256 + c;
        }
        count = count + 1;
        c = getchar(io);
    }
    return w;
}

pub fn read_int[&i](io: &!i Io) -> [io_read] int {
    var c = getchar(io);
    while c >= 0 && is_space(c) {
        c = getchar(io);
    }
    var sign = 1;
    if c == '-' {
        sign = 0 - 1;
        c = getchar(io);
    }
    var v = 0;
    while c >= '0' && c <= '9' {
        v = v * 10 + (c - '0');
        c = getchar(io);
    }
    return sign * v;
}

// A number written as text (`0.5`, `1e-6`) read by way of the JSON reader; (false, 0) when it is not a finite one.
pub fn parse_float[&s](tok: &s [byte]) -> [] (bool, float) {
    if len(tok) == 0 {
        return (false, 0.0);
    }
    var ok = false;
    var out = 0.0;
    region r {
        let src = alloc_slice[r](len(tok) + 2, byte_of(0));
        src[0] = byte_of('[');
        var k = 0;
        while k < len(tok) {
            src[1 + k] = tok[k];
            k = k + 1;
        }
        src[len(tok) + 1] = byte_of(']');
        let all = src[0..len(tok) + 2];
        let tape = alloc_slice[r](json.tape_len(all), 0);
        if json.parse(all, tape) > 0 && json.is_number(tape, 1) && json.count(tape, 0) == 1 {
            out = json.to_float(all, tape, 1);
            ok = out - out == 0.0;
        }
    }
    return (ok, out);
}
