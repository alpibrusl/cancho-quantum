module qc.qasm;

import qc.dump;
import qc.gates;
import qc.measure;
import std.fmt;
import std.io;
import std.math;

// A subset of OpenQASM 2.0, read from standard input and run on the state
// vector. It is what Qiskit writes for circuits of the gates this simulator
// has, and what `scripts/qc_to_qasm.py` writes from a `.qc` file.
//
//   OPENQASM 2.0;  include "qelib1.inc";        skipped
//   qreg q[N];                                  one register; sets the qubit count
//   creg c[N];                                  up to four, of 1 to 20 bits; barrier ...;  skipped
//   h x y z s sdg t tdg sx sxdg id q[i];        single-qubit gates (sx = H S H, sxdg = H Sdg H, id does nothing)
//   rx(a) ry(a) rz(a) p(a) u1(a) q[i];          one angle
//   u2(a,b) u3(a,b,c) u(a,b,c) q[i];            u3(t,f,l) = p(f) ry(t) p(l) exactly, u2(f,l) = u3(pi/2,f,l)
//   cx cy cz ch swap q[i],q[j];  cp(a) cu1(a) crz(a) rzz(a) q[i],q[j];  ccx cswap q[i],q[j],q[k];   cy ch crz rzz cswap are the true matrices of qelib1.inc
//   measure q[i] -> c[j];                       measure q[i] (without the arrow the outcome is only printed); the bit goes into c
//   if (c==k) <statement>;                      the statement runs when the creg c holds k, and is skipped otherwise
//   gate name(a,b) x,y { rx(a*2+b) x; cx x,y; }   a definition: up to 64, stored as text and expanded at each call (docs/qasm-gates.md); a call is `name(1,pi/2) q[0],q[1];`
//   U(t,f,l) q[i];  CX q[i],q[j];                the two gates a definition of any other is written from
//
// An angle is an expression: `0.785398`, `-1.2e-3`, `pi`, `3*pi/4`, `2*pi/3 + sin(0.1)`, with + - * / ^, parentheses and sin cos tan exp ln sqrt (docs/qasm-gates.md section 4). A multiple of pi by whole
// numbers (`3*pi/4`, `-pi/2`) stays `pi * num / den`, the double the references compute, bit for bit; a decimal is read to the correctly rounded double (checked against Python's in scripts/check_qasm.py) when its
// digits (at most 18) times its power of ten are an integer below 2^62, or the power is 18 below, or 22 either way for digits below 2^53, and to within a few units in the last place beyond that, where an angle is far
// too small or too large to matter (docs/features-results.md). `reset`, `opaque` and a second `qreg` are refused with a line that says what.
//
// A word is its characters packed big-endian into an int, the first seven
// only, the same trick `main.cho` uses.

// `la` is the reader's one array of ints (docs/qasm-gates.md section 3). Its cells:
//   0 the character under the cursor, -1 at the end of input       1 depth: 0 reads standard input, d reads the d-th expansion of a gate call
//   2 gate definitions stored    3 where the next one goes          4 gate calls expanded so far          5 length of the last word read
//   6 the top of the expansion area                                 8..39 the frames (4 cells each: next cell, end, character saved, top saved)
//   40..63 qubit operands of a call   64..95 where each angle's text of a call is   96..159 the characters of the last word   160..287 the table of definitions (start, length)
//   288.. the text of the definitions, 24,000 cells, then the expansions
fn advance[&i, &l](io: &!i Io, la: &!l [int]) -> [io_read] int {
    if la[1] == 0 {
        la[0] = getchar(io);
    } else {
        let f = 8 + (la[1] - 1) * 4;
        if la[f] < la[f + 1] {
            la[0] = la[la[f]];
            la[f] = la[f] + 1;
        } else {
            // the expansion is read: back to the text it was called from, with the character that was under the cursor then
            la[0] = la[f + 2];
            la[6] = la[f + 3];
            la[1] = la[1] - 1;
        }
    }
    return la[0];
}

fn is_space(c: int) -> [] bool {
    return c == 32 || c == 10 || c == 13 || c == 9;
}

fn is_word(c: int) -> [] bool {
    return c >= 'a' && c <= 'z' || c >= 'A' && c <= 'Z' || c >= '0' && c <= '9' || c == '_';
}

// Skip white space.
fn skip[&i, &l](io: &!i Io, la: &!l [int]) -> [io_read] int {
    while la[0] >= 0 && is_space(la[0]) {
        advance(io, la);
    }
    return 0;
}

// Skip white space and `//` comments, at the start of a statement only: inside
// a statement a `/` is division (`pi/4`), and with one character of lookahead
// the two cannot be told apart anywhere else.
fn skip_statement[&i, &l](io: &!i Io, la: &!l [int]) -> [io_read] int {
    skip(io, la);
    while la[0] == '/' {
        while la[0] >= 0 && la[0] != 10 {
            advance(io, la);
        }
        skip(io, la);
    }
    return 0;
}

// The next identifier, packed; 0 if the next character does not start one, -2 if it is longer than seven characters (so it is never a built-in: docs/qasm-gates.md section 3). Its characters, up to 63, and its
// length are left in `la` for the lookup of a defined gate.
fn word[&i, &l](io: &!i Io, la: &!l [int]) -> [io_read] int {
    skip(io, la);
    var w = 0;
    var count = 0;
    while la[0] >= 0 && is_word(la[0]) {
        if count < 7 {
            w = w * 256 + la[0];
        }
        if count < 63 {
            la[96 + count] = la[0];
        }
        count = count + 1;
        advance(io, la);
    }
    la[5] = count;
    if count > 7 {
        return 0 - 2;
    }
    return w;
}

fn uint[&i, &l](io: &!i Io, la: &!l [int]) -> [io_read] int {
    skip(io, la);
    var v = 0;
    while la[0] >= '0' && la[0] <= '9' {
        v = v * 10 + (la[0] - '0');
        advance(io, la);
    }
    return v;
}

// Consume `c`; answer false if it was not next.
fn expect[&i, &l](io: &!i Io, la: &!l [int], c: int) -> [io_read] bool {
    skip(io, la);
    if la[0] == c {
        advance(io, la);
        return true;
    }
    return false;
}

fn to_semicolon[&i, &l](io: &!i Io, la: &!l [int]) -> [io_read] int {
    while la[0] >= 0 && la[0] != ';' {
        advance(io, la);
    }
    advance(io, la);
    return 0;
}

// `name[index]`: the register name is skipped, the index answered.
fn operand[&i, &l](io: &!i Io, la: &!l [int]) -> [io_read] int {
    word(io, la);
    if !expect(io, la, '[') {
        return 0 - 1;
    }
    let k = uint(io, la);
    if !expect(io, la, ']') {
        return 0 - 1;
    }
    return k;
}

// 10^k for k from 0 to 22, every one of them exact in a double
fn pow10(k: int) -> [] float {
    var v = 1.0;
    var j = 0;
    while j < k {
        v = v * 10.0;
        j = j + 1;
    }
    return v;
}

// 10^k as an integer, k up to 18
fn pow10_int(k: int) -> [] int {
    var v = 1;
    var j = 0;
    while j < k {
        v = v * 10;
        j = j + 1;
    }
    return v;
}

// m / 10^k correctly rounded (to nearest, ties to even), for m at least 2^53 and k from 1 to 18: the quotient's bits by long division, 54 of them, then the rounding by hand. Dividing the double of m by the
// double of 10^k would round twice.
fn quotient(m: int, k: int) -> [] float {
    let d = pow10_int(k);
    var q = m / d;
    var r = m - q * d;
    var f = 0;
    var mant = 0;
    var exp2 = 0;
    var up = false;
    if q >= 9007199254740992 {
        // 54 to 60 bits: keep the top 53, the rest decides the rounding
        var nb = 0;
        var t = q;
        while t > 0 {
            t = t / 2;
            nb = nb + 1;
        }
        let shift = nb - 53;
        let unit = 1 << shift;
        mant = q / unit;
        let rest = q - mant * unit;
        let half = unit / 2;
        up = rest > half || rest == half && (r != 0 || mant % 2 == 1);
        exp2 = shift;
    } else {
        while q < 9007199254740992 {
            r = r * 2;
            q = q * 2;
            if r >= d {
                r = r - d;
                q = q + 1;
            }
            f = f + 1;
        }
        mant = q / 2;
        let roundbit = q - mant * 2;
        up = roundbit == 1 && (r != 0 || mant % 2 == 1);
        exp2 = 0 - (f - 1);
    }
    if up {
        mant = mant + 1;
    }
    var v = float_of(mant);
    var j = exp2;
    while j > 0 {
        v = v * 2.0;
        j = j - 1;
    }
    while j < 0 {
        v = v / 2.0;
        j = j + 1;
    }
    return v;
}

// An unsigned number: digits, optionally a point and more digits, optionally `e` or `E`, a sign and an exponent. Answers (kind, integer, value): kind 0 when there is no number or it is out of range, 1 for plain digits
// (the integer is then their value), 2 for a decimal. The value is the digits (the first 18 significant ones) as an integer, scaled by a power of ten: correctly rounded in the range qasm's header gives, within a few units in the last place beyond it (docs/features-results.md).
pub fn number[&i, &l](io: &!i Io, la: &!l [int]) -> [io_read] (int, int, float) {
    skip(io, la);
    if !(la[0] >= '0' && la[0] <= '9') && la[0] != '.' {
        return (0, 0, 0.0);
    }
    var m = 0;
    var significant = 0;
    var dropped = 0;
    var fraction = 0;
    var decimal = false;
    var digits = 0;
    while la[0] >= '0' && la[0] <= '9' {
        if significant < 18 {
            m = m * 10 + (la[0] - '0');
            if m != 0 {
                significant = significant + 1;
            }
        } else {
            dropped = dropped + 1;
        }
        digits = digits + 1;
        advance(io, la);
    }
    var whole = m;
    if la[0] == '.' {
        decimal = true;
        advance(io, la);
        while la[0] >= '0' && la[0] <= '9' {
            if significant < 18 {
                m = m * 10 + (la[0] - '0');
                if m != 0 {
                    significant = significant + 1;
                }
                fraction = fraction + 1;
            }
            digits = digits + 1;
            advance(io, la);
        }
    }
    if digits == 0 {
        return (0, 0, 0.0);
    }
    var ex = 0;
    if la[0] == 'e' || la[0] == 'E' {
        decimal = true;
        advance(io, la);
        var neg = false;
        if la[0] == '-' {
            neg = true;
            advance(io, la);
        } else if la[0] == '+' {
            advance(io, la);
        }
        if !(la[0] >= '0' && la[0] <= '9') {
            return (0, 0, 0.0);
        }
        while la[0] >= '0' && la[0] <= '9' {
            if ex < 10000 {
                ex = ex * 10 + (la[0] - '0');
            }
            advance(io, la);
        }
        if neg {
            ex = 0 - ex;
        }
    }
    if !decimal {
        if dropped > 0 {
            return (0, 0, 0.0);
        }
        return (1, whole, float_of(whole));
    }
    var e10 = ex - fraction + dropped;
    if m == 0 {
        return (2, 0, 0.0);
    }
    if e10 > 40 {
        return (0, 0, 0.0);
    }
    var v = float_of(m);
    var big = m >= 9007199254740992;
    if e10 < 0 && e10 >= 0 - 18 && big {
        v = quotient(m, 0 - e10);
        e10 = 0;
    } else if e10 > 0 && e10 <= 18 && m <= 4611686018427387904 / pow10_int(e10) {
        v = float_of(m * pow10_int(e10));
        e10 = 0;
    }
    while e10 > 0 {
        var step = e10;
        if step > 22 {
            step = 22;
        }
        v = v * pow10(step);
        e10 = e10 - step;
    }
    while e10 < 0 {
        var step = 0 - e10;
        if step > 22 {
            step = 22;
        }
        v = v / pow10(step);
        e10 = e10 + step;
        if v == 0.0 {
            e10 = 0;
        }
    }
    return (2, 0, v);
}

// ---- angle expressions (docs/qasm-gates.md section 4) ------------------------------------------------------------------------------------------------------
// A value is (kind, a, b, v): kind 0 a double v, kind 1 the multiple a/b of pi (v is its double, `pi * a / b`), kind 2 the integer a, kind -1 an error. Multiples of pi stay multiples of pi through `*` and `/` by integers, which is what
// keeps every angle of the old grammar (`3*pi/4`, `-pi/2`, `0`) the double the references compute.

fn small(x: int) -> [] bool {
    return x > 0 - 1000000000 && x < 1000000000;
}

fn bad_value() -> [] (int, int, int, float) {
    return (0 - 1, 0, 1, 0.0);
}

fn atom[&i, &l](io: &!i Io, la: &!l [int]) -> [io_read] (int, int, int, float) {
    skip(io, la);
    if la[0] == '(' {
        advance(io, la);
        let (k, a, b, v) = expr(io, la);
        if k < 0 || !expect(io, la, ')') {
            return bad_value();
        }
        return (k, a, b, v);
    }
    if la[0] >= '0' && la[0] <= '9' || la[0] == '.' {
        let (nk, whole, nv) = number(io, la);
        if nk == 1 {
            return (2, whole, 1, nv);
        }
        if nk == 2 {
            return (0, 0, 1, nv);
        }
        return bad_value();
    }
    let name = word(io, la);
    if name == 28777 {
        return (1, 1, 1, gates.pi());
    }
    if name == 7563630 || name == 6516595 || name == 7627118 || name == 6649968 || name == 27758 || name == 1936814708 {
        if !expect(io, la, '(') {
            return bad_value();
        }
        let (k, a, b, v) = expr(io, la);
        if k < 0 || !expect(io, la, ')') {
            return bad_value();
        }
        var r = 0.0;
        if name == 7563630 {
            r = math.sin(v);
        } else if name == 6516595 {
            r = math.cos(v);
        } else if name == 7627118 {
            r = math.tan(v);
        } else if name == 6649968 {
            r = math.exp(v);
        } else if name == 27758 {
            if v <= 0.0 {
                return bad_value();
            }
            r = math.log(v);
        } else {
            if v < 0.0 {
                return bad_value();
            }
            r = sqrt(v);
        }
        if r - r != 0.0 {
            return bad_value();
        }
        return (0, 0, 1, r);
    }
    return bad_value();
}

fn power[&i, &l](io: &!i Io, la: &!l [int]) -> [io_read] (int, int, int, float) {
    let (k, a, b, v) = atom(io, la);
    skip(io, la);
    if k >= 0 && la[0] == '^' {
        advance(io, la);
        let (k2, a2, b2, v2) = unary(io, la);
        if k2 < 0 {
            return bad_value();
        }
        let r = math.pow(v, v2);
        if r - r != 0.0 {
            return bad_value();
        }
        return (0, 0, 1, r);
    }
    return (k, a, b, v);
}

fn unary[&i, &l](io: &!i Io, la: &!l [int]) -> [io_read] (int, int, int, float) {
    skip(io, la);
    if la[0] == '-' {
        advance(io, la);
        let (k, a, b, v) = unary(io, la);
        if k == 1 {
            return (1, 0 - a, b, 0.0 - v);
        }
        if k == 2 {
            return (2, 0 - a, 1, 0.0 - v);
        }
        if k == 0 {
            return (0, 0, 1, 0.0 - v);
        }
        return bad_value();
    }
    if la[0] == '+' {
        advance(io, la);
        return unary(io, la);
    }
    return power(io, la);
}

fn term[&i, &l](io: &!i Io, la: &!l [int]) -> [io_read] (int, int, int, float) {
    let (k0, a0, b0, v0) = unary(io, la);
    var k = k0;
    var a = a0;
    var b = b0;
    var v = v0;
    var go = k >= 0;
    while go {
        skip(io, la);
        let op = la[0];
        if op == '*' || op == '/' {
            advance(io, la);
            let (k2, a2, b2, v2) = unary(io, la);
            if k2 < 0 {
                k = 0 - 1;
                go = false;
            } else if op == '*' {
                if k == 2 && k2 == 2 && small(a) && small(a2) {
                    a = a * a2;
                    v = float_of(a);
                } else if k == 2 && k2 == 1 && small(a) && small(a2) {
                    k = 1;
                    a = a * a2;
                    b = b2;
                    v = gates.angle(a, b);
                } else if k == 1 && k2 == 2 && small(a) && small(a2) {
                    a = a * a2;
                    v = gates.angle(a, b);
                } else {
                    k = 0;
                    v = v * v2;
                }
            } else if v2 == 0.0 {
                k = 0 - 1;
                go = false;
            } else if k == 1 && k2 == 2 && small(b) && small(a2) {
                b = b * a2;
                v = gates.angle(a, b);
            } else {
                k = 0;
                v = v / v2;
            }
        } else {
            go = false;
        }
    }
    return (k, a, b, v);
}

fn expr[&i, &l](io: &!i Io, la: &!l [int]) -> [io_read] (int, int, int, float) {
    let (k0, a0, b0, v0) = term(io, la);
    var k = k0;
    var a = a0;
    var b = b0;
    var v = v0;
    var go = k >= 0;
    while go {
        skip(io, la);
        let op = la[0];
        if op == '+' || op == '-' {
            advance(io, la);
            let (k2, a2, b2, v2) = term(io, la);
            if k2 < 0 {
                k = 0 - 1;
                go = false;
            } else {
                if op == '+' {
                    v = v + v2;
                } else {
                    v = v - v2;
                }
                k = 0;
            }
        } else {
            go = false;
        }
    }
    return (k, a, b, v);
}

// An angle, up to and including the character `close` (`)` after the last of a gate's angles, `,` after the others): an expression (numbers, `pi`, `+ - * / ^`, parentheses, `sin cos tan exp ln sqrt`).
// Answers (ok, angle), ok 0 when it is outside the subset or not finite.
fn angle[&i, &l](io: &!i Io, la: &!l [int], close: int) -> [io_read] (int, float) {
    let (k, a, b, v) = expr(io, la);
    if k < 0 || !expect(io, la, close) {
        return (0, 0.0);
    }
    if k == 1 {
        return (1, gates.angle(a, b));
    }
    if v - v != 0.0 {
        return (0, 0.0);
    }
    return (1, v);
}

// The creg called `name` (packed as `word` packs): its number from 0, or -1
fn creg_find[&q](qubits: &q [int], name: int) -> [] int {
    var r = 0;
    while r < qubits[1] {
        if qubits[2 + 3 * r] == name {
            return r;
        }
        r = r + 1;
    }
    return 0 - 1;
}

fn refuse[&i, &r](io: &!i Io, why: &r [byte]) -> [io_write] int {
    io.write_all(io, "error: ");
    io.write_all(io, why);
    io.newline(io);
    return 3;
}

// ---- gate definitions (docs/qasm-gates.md) --------------------------------------------------------------------------------------------------------------------

// where the text of the definitions ends and the expansions begin in `la`
fn def_end() -> [] int {
    return 24288;
}

fn ident_end[&l](la: &l [int], i: int, limit: int) -> [] int {
    var k = i;
    while k < limit && is_word(la[k]) {
        k = k + 1;
    }
    return k;
}

fn skip_blank[&l](la: &l [int], i: int, limit: int) -> [] int {
    var k = i;
    while k < limit && is_space(la[k]) {
        k = k + 1;
    }
    return k;
}

fn same_text[&l](la: &l [int], a: int, alen: int, b: int, blen: int) -> [] bool {
    if alen != blen {
        return false;
    }
    var k = 0;
    while k < alen {
        if la[a + k] != la[b + k] {
            return false;
        }
        k = k + 1;
    }
    return true;
}

// The identifiers, comma separated, from `i` to the first `)` or `{` (or `e`): answers (start, length of the k-th one, how many, where it stopped).
fn scan_list[&l](la: &l [int], i: int, e: int, k: int) -> [] (int, int, int, int) {
    var count = 0;
    var ks = 0;
    var kl = 0;
    var p = skip_blank(la, i, e);
    var more = true;
    while more && p < e {
        let c = la[p];
        if c == ')' || c == '{' {
            more = false;
        } else if is_word(c) {
            let q = ident_end(la, p, e);
            if count == k {
                ks = p;
                kl = q - p;
            }
            count = count + 1;
            p = skip_blank(la, q, e);
            if p < e && la[p] == ',' {
                p = skip_blank(la, p + 1, e);
            }
        } else {
            more = false;
        }
    }
    return (ks, kl, count, p);
}

// The definition called by the last word read, or -1.
fn find_def[&l](la: &l [int]) -> [] int {
    let n = la[5];
    if n > 63 {
        return 0 - 1;
    }
    var d = 0;
    while d < la[2] {
        let s = la[160 + 2 * d];
        if same_text(la, s, ident_end(la, s, s + la[161 + 2 * d]) - s, 96, n) {
            return d;
        }
        d = d + 1;
    }
    return 0 - 1;
}

// Is the text from `s` to `e` a definition: `name [(params)] qubits { ... }`, with 1 to 24 qubits and up to 16 params, and a name not defined yet? 0 when it is, else the message.
fn definition_fault[&l](la: &l [int], s: int, e: int) -> [] int {
    let ne = ident_end(la, s, e);
    if ne == s || la[s] >= '0' && la[s] <= '9' {
        return 1;
    }
    var d = 0;
    while d < la[2] {
        let t = la[160 + 2 * d];
        if same_text(la, t, ident_end(la, t, t + la[161 + 2 * d]) - t, s, ne - s) {
            return 2;
        }
        d = d + 1;
    }
    var p = skip_blank(la, ne, e);
    if la[p] == '(' {
        let (a1, b1, np, p1) = scan_list(la, p + 1, e, 0);
        if la[p1] != ')' || np > 16 {
            return 1;
        }
        p = skip_blank(la, p1 + 1, e);
    }
    let (a2, b2, nq, p2) = scan_list(la, p, e, 0);
    if la[p2] != '{' || nq < 1 || nq > 24 {
        return 1;
    }
    return 0;
}

// `gate name [(params)] qubits { body }`: the text from the name to the `}` goes into the definition area (without `//` comments), and the next statement is read after it.
fn define[&i, &l](io: &!i Io, la: &!l [int]) -> [io_read, io_write] int {
    skip(io, la);
    if la[2] >= 64 {
        return refuse(io, "more than 64 gate definitions");
    }
    let start = la[3];
    var top = start;
    var done = false;
    var opened = false;
    var status = 0;
    while !done && status == 0 {
        let c = la[0];
        if c < 0 {
            status = 2;
        } else if c == '{' && opened {
            status = refuse(io, "a gate defined inside a gate");
        } else if top >= def_end() - 1 {
            status = refuse(io, "gate definitions of more than 24,000 characters in all");
        } else if c == '/' {
            advance(io, la);
            if la[0] == '/' {
                while la[0] >= 0 && la[0] != 10 {
                    advance(io, la);
                }
            } else {
                la[top] = '/';
                top = top + 1;
            }
        } else {
            la[top] = c;
            top = top + 1;
            if c == '{' {
                opened = true;
            }
            if c == '}' {
                done = true;
            }
            advance(io, la);
        }
    }
    if status == 0 {
        let fault = definition_fault(la, start, top);
        if fault == 1 {
            status = refuse(io, "a gate definition is not `name [(params)] qubits { statements }` with up to 24 qubits");
        } else if fault == 2 {
            status = refuse(io, "a gate defined twice");
        } else {
            la[160 + 2 * la[2]] = start;
            la[161 + 2 * la[2]] = top - start;
            la[2] = la[2] + 1;
            la[3] = top;
        }
    }
    return status;
}

// A call of the defined gate `d`, whose name has been read: the angles and qubits that follow are read, the body is copied above the expansions already made with the angle names replaced by `(value)` and the qubit names
// by `q[index]`, and the copy becomes the input until it is read (a frame: docs/qasm-gates.md section 3). Answers 0 or a status.
fn call_user[&i, &b, &l](io: &!i Io, scratch: &!b [byte], la: &!l [int], d: int, n: int) -> [io_read, io_write] int {
    let s = la[160 + 2 * d];
    let e = s + la[161 + 2 * d];
    let after = skip_blank(la, ident_end(la, s, e), e);
    var np = 0;
    var pstart = 0 - 1;
    var qstart = after;
    if la[after] == '(' {
        pstart = after + 1;
        let (a1, b1, c1, p1) = scan_list(la, pstart, e, 0);
        np = c1;
        qstart = skip_blank(la, p1 + 1, e);
    }
    let (a2, b2, nq, p2) = scan_list(la, qstart, e, 0);
    if la[1] >= 8 {
        return refuse(io, "gates nested deeper than 8");
    }
    la[4] = la[4] + 1;
    if la[4] > 200000 {
        return refuse(io, "more than 200,000 gate calls");
    }
    var top = la[6];
    let room = len(la) - 64;
    var status = 0;
    if np > 0 && !expect(io, la, '(') {
        status = refuse(io, "a gate call needs its angles in parentheses");
    }
    var k = 0;
    while k < np && status == 0 {
        var close = ')';
        if k + 1 < np {
            close = ',';
        }
        let (ok, theta) = angle(io, la, close);
        if ok == 0 {
            status = refuse(io, "a gate call whose angles are not the definition's, or outside the subset");
        } else {
            let count = fmt.float_into(scratch, theta);
            if top + count >= room {
                status = refuse(io, "gate expansion too long");
            } else {
                la[64 + 2 * k] = top;
                la[65 + 2 * k] = count;
                var j = 0;
                while j < count {
                    la[top + j] = int_of(scratch[j]);
                    j = j + 1;
                }
                top = top + count;
            }
        }
        k = k + 1;
    }
    k = 0;
    while k < nq && status == 0 {
        if k > 0 {
            expect(io, la, ',');
        }
        let q = operand(io, la);
        if q < 0 || q >= n {
            status = 2;
        } else {
            var j = 0;
            while j < k {
                if la[40 + j] == q {
                    status = 2;
                }
                j = j + 1;
            }
            la[40 + k] = q;
        }
        k = k + 1;
    }
    skip(io, la);
    if status == 0 && la[0] != ';' {
        status = 2;
    }
    to_semicolon(io, la);
    if status != 0 {
        return status;
    }
    // the body, with the names replaced
    let start = top;
    var i = p2 + 1;
    let stop = e - 1;
    while i < stop && status == 0 {
        let c = la[i];
        if top + 40 >= room {
            status = refuse(io, "gate expansion too long");
        } else if is_word(c) && !(c >= '0' && c <= '9') {
            let q = ident_end(la, i, stop);
            var found = false;
            var j = 0;
            while j < np && !found {
                let (ks, kl, kc, kp) = scan_list(la, pstart, e, j);
                if same_text(la, i, q - i, ks, kl) {
                    found = true;
                    la[top] = '(';
                    top = top + 1;
                    var m = 0;
                    while m < la[65 + 2 * j] {
                        la[top] = la[la[64 + 2 * j] + m];
                        top = top + 1;
                        m = m + 1;
                    }
                    la[top] = ')';
                    top = top + 1;
                }
                j = j + 1;
            }
            j = 0;
            while j < nq && !found {
                let (ks, kl, kc, kp) = scan_list(la, qstart, e, j);
                if same_text(la, i, q - i, ks, kl) {
                    found = true;
                    la[top] = 'q';
                    la[top + 1] = '[';
                    top = top + 2;
                    let at = la[40 + j];
                    if at >= 10 {
                        la[top] = '0' + at / 10;
                        top = top + 1;
                    }
                    la[top] = '0' + at % 10;
                    la[top + 1] = ']';
                    top = top + 2;
                }
                j = j + 1;
            }
            if !found {
                var m = i;
                while m < q {
                    la[top] = la[m];
                    top = top + 1;
                    m = m + 1;
                }
            }
            i = q;
        } else if c >= '0' && c <= '9' || c == '.' {
            var q = i;
            var go = true;
            while q < stop && go {
                let t = la[q];
                if t >= '0' && t <= '9' || t == '.' {
                    q = q + 1;
                } else if t == 'e' || t == 'E' {
                    q = q + 1;
                    if q < stop && (la[q] == '+' || la[q] == '-') {
                        q = q + 1;
                    }
                } else {
                    go = false;
                }
            }
            var m = i;
            while m < q {
                la[top] = la[m];
                top = top + 1;
                m = m + 1;
            }
            i = q;
        } else {
            la[top] = c;
            top = top + 1;
            i = i + 1;
        }
    }
    if status == 0 && top > start {
        let f = 8 + la[1] * 4;
        la[f] = start + 1;
        la[f + 1] = top;
        la[f + 2] = la[0];
        la[f + 3] = la[6];
        la[6] = top;
        la[1] = la[1] + 1;
        la[0] = la[start];
    }
    return status;
}

// Run the statements that follow `OPENQASM`. Answers 0, or a status: 2 for
// malformed input, 3 for something outside the subset.
pub fn run[&i, &s, &r, &b, &l, &q](io: &!i Io, st: &!s [float], qubits: &!q [int], rng: &!r [int], scratch: &!b [byte], la: &!l [int]) -> [io_read, io_write] int {
    la[3] = 288;
    la[6] = def_end();
    advance(io, la);
    to_semicolon(io, la);
    var status = 0;
    var n = 0;
    var done = false;
    while !done && status == 0 {
        skip_statement(io, la);
        let w = word(io, la);
        if w == 0 && la[0] >= 0 {
            status = 2;
        } else if w == 0 {
            done = true;
        } else if w == 22324781757055315 || w == 29676245855069285 || w == 27691691891320178 {
            to_semicolon(io, la);
        } else if w == 1903322471 {
            if n != 0 {
                status = refuse(io, "a second qreg");
            } else {
                word(io, la);
                expect(io, la, '[');
                n = uint(io, la);
                expect(io, la, ']');
                to_semicolon(io, la);
                if n < 1 || n > 20 {
                    status = refuse(io, "qreg size must be 1 to 20");
                } else {
                    qubits[0] = n;
                }
            }
        } else if w == 1734440037 {
            if la[1] != 0 {
                status = refuse(io, "a gate defined inside a gate");
            } else {
                status = define(io, la);
            }
        } else if w == 122528461845861 {
            to_semicolon(io, la);
            status = refuse(io, "opaque gates are not read");
        } else if w == 1668441447 {
            // creg name[size]: up to four, each a value of up to 20 bits that `measure q[i] -> name[j]` sets bit j of and `if (name==k)` tests
            let nm = word(io, la);
            expect(io, la, '[');
            let size = uint(io, la);
            expect(io, la, ']');
            to_semicolon(io, la);
            let r = qubits[1];
            if r >= 4 {
                status = refuse(io, "more than four cregs");
            } else if size < 1 || size > 20 {
                status = refuse(io, "creg size must be 1 to 20");
            } else {
                qubits[2 + 3 * r] = nm;
                qubits[3 + 3 * r] = size;
                qubits[4 + 3 * r] = 0;
                qubits[1] = r + 1;
            }
        } else if n == 0 {
            status = refuse(io, "a gate before qreg");
        } else if la[2] > 0 && find_def(la) >= 0 {
            // a defined gate wins over a built-in of the same name, as in Qiskit's loader
            status = call_user(io, scratch, la, find_def(la), n);
        } else if la[1] > 0 && (w == 30792241684771429 || w == 26982 || w == 491328333172) {
            to_semicolon(io, la);
            status = refuse(io, "measure, reset and if are not allowed inside a gate");
        } else if w == 30792241684771429 {
            let q = operand(io, la);
            // `-> name[j]` (or `-> name` for a register of one bit) names the bit the outcome goes to
            var r = 0 - 1;
            var bit = 0;
            var bad = false;
            if expect(io, la, '-') {
                expect(io, la, '>');
                r = creg_find(qubits, word(io, la));
                if r < 0 {
                    bad = true;
                } else if expect(io, la, '[') {
                    bit = uint(io, la);
                    expect(io, la, ']');
                }
                if r >= 0 && bit >= qubits[3 + 3 * r] {
                    bad = true;
                }
            }
            to_semicolon(io, la);
            if q < 0 || q >= n || bad {
                status = 2;
            } else {
                let outcome = measure.measure(st, n, q, rng);
                dump.measurement(io, q, outcome);
                if r >= 0 {
                    let mask = 1 << bit;
                    var value = qubits[4 + 3 * r] | mask;
                    if outcome == 0 {
                        value = value ^ mask;
                    }
                    qubits[4 + 3 * r] = value;
                }
            }
        } else if w == 26982 {
            // if (name==k) statement: the statement is skipped unless the register holds k
            var good = expect(io, la, '(');
            let r = creg_find(qubits, word(io, la));
            good = good && expect(io, la, '=') && expect(io, la, '=');
            let k = uint(io, la);
            good = good && expect(io, la, ')') && r >= 0;
            if !good {
                to_semicolon(io, la);
                status = 2;
            } else if qubits[4 + 3 * r] != k {
                to_semicolon(io, la);
            }
        } else if w == 104 || w == 120 || w == 121 || w == 122 || w == 115 || w == 116 || w == 7562343 || w == 7627879 {
            let q = operand(io, la);
            to_semicolon(io, la);
            if q < 0 || q >= n {
                status = 2;
            } else if w == 104 {
                gates.h(st, n, q);
            } else if w == 120 {
                gates.x(st, n, q);
            } else if w == 121 {
                gates.y(st, n, q);
            } else if w == 122 {
                gates.z(st, n, q);
            } else if w == 115 {
                gates.s(st, n, q);
            } else if w == 116 {
                gates.t(st, n, q);
            } else if w == 7562343 {
                gates.sdg(st, n, q);
            } else {
                gates.tdg(st, n, q);
            }
        } else if w == 29304 || w == 29305 || w == 29306 || w == 112 || w == 30001 {
            if !expect(io, la, '(') {
                status = 2;
            } else {
                let (good, theta) = angle(io, la, ')');
                let q = operand(io, la);
                to_semicolon(io, la);
                if good == 0 {
                    status = refuse(io, "an angle must be a number or a multiple of pi (0.785, pi, -pi/2, 3*pi/4)");
                } else if q < 0 || q >= n {
                    status = 2;
                } else if w == 29304 {
                    gates.rx(st, n, q, theta);
                } else if w == 29305 {
                    gates.ry(st, n, q, theta);
                } else if w == 29306 {
                    gates.rz(st, n, q, theta);
                } else {
                    gates.p(st, n, q, theta);
                }
            }
        } else if w == 29560 || w == 1937269863 || w == 26980 {
            let q = operand(io, la);
            to_semicolon(io, la);
            if q < 0 || q >= n {
                status = 2;
            } else if w == 29560 {
                gates.h(st, n, q);
                gates.s(st, n, q);
                gates.h(st, n, q);
            } else if w == 1937269863 {
                gates.h(st, n, q);
                gates.sdg(st, n, q);
                gates.h(st, n, q);
            }
        } else if w == 30002 || w == 30003 || w == 117 || w == 85 {
            // u2(f,l), u3(t,f,l), u(t,f,l): p(f) ry(t) p(l), the first one applied last
            var ok = expect(io, la, '(');
            var theta = gates.angle(1, 2);
            var bad = 0;
            if ok && w != 30002 {
                let (g1, t1) = angle(io, la, ',');
                theta = t1;
                if g1 == 0 {
                    bad = 1;
                }
            }
            let (g2, phi) = angle(io, la, ',');
            let (g3, lambda) = angle(io, la, ')');
            let q = operand(io, la);
            to_semicolon(io, la);
            if !ok {
                status = 2;
            } else if bad == 1 || g2 == 0 || g3 == 0 {
                status = refuse(io, "an angle must be a number or a multiple of pi (0.785, pi, -pi/2, 3*pi/4)");
            } else if q < 0 || q >= n {
                status = 2;
            } else {
                gates.p(st, n, q, lambda);
                gates.ry(st, n, q, theta);
                gates.p(st, n, q, phi);
            }
        } else if w == 25464 || w == 25466 || w == 1937203568 || w == 25465 || w == 25448 || w == 17240 {
            let a = operand(io, la);
            expect(io, la, ',');
            let c = operand(io, la);
            to_semicolon(io, la);
            if a < 0 || c < 0 || a >= n || c >= n {
                status = 2;
            } else if w == 25464 {
                gates.cx(st, n, a, c);
            } else if w == 25466 {
                gates.cz(st, n, a, c);
            } else if w == 25465 {
                gates.cy(st, n, a, c);
            } else if w == 25448 {
                gates.ch(st, n, a, c);
            } else {
                gates.swap(st, n, a, c);
            }
        } else if w == 25456 || w == 6518065 || w == 6517370 || w == 7502458 {
            if !expect(io, la, '(') {
                status = 2;
            } else {
                let (good, theta) = angle(io, la, ')');
                let a = operand(io, la);
                expect(io, la, ',');
                let c = operand(io, la);
                to_semicolon(io, la);
                if good == 0 {
                    status = refuse(io, "an angle must be a number or a multiple of pi (0.785, pi, -pi/2, 3*pi/4)");
                } else if a < 0 || c < 0 || a >= n || c >= n {
                    status = 2;
                } else if w == 6517370 {
                    gates.crz(st, n, a, c, theta);
                } else if w == 7502458 {
                    gates.rzz(st, n, a, c, theta);
                } else {
                    gates.cp(st, n, a, c, theta);
                }
            }
        } else if w == 6513528 || w == 427138965872 {
            let a = operand(io, la);
            expect(io, la, ',');
            let c = operand(io, la);
            expect(io, la, ',');
            let t = operand(io, la);
            to_semicolon(io, la);
            if a < 0 || c < 0 || t < 0 || a >= n || c >= n || t >= n {
                status = 2;
            } else {
                if w == 6513528 {
                    gates.ccx(st, n, a, c, t);
                } else {
                    gates.cswap(st, n, a, c, t);
                }
            }
        } else {
            to_semicolon(io, la);
            status = refuse(io, "a statement outside the supported OpenQASM subset");
        }
    }
    return status;
}
