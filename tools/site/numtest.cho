// Test driver for numfmt.cho: reads lines `fixed N X`, `sci N X`, `general X`, `repr X`, `round N X` and prints
// the result of each on a line. X is a JSON number. Used by scripts/check_site_tools.py against Python's formatting.

import site.numfmt;
import std.buffer;
import std.bytes;
import std.io;
import std.json;

fn number[&s](text: &s [byte]) -> [] float {
    var v = 0.0;
    region r {
        let tape = alloc_slice[r](json.tape_len(text), 0);
        let n = json.parse(text, tape);
        if n > 0 {
            v = json.to_float(text, tape, 0);
        }
    }
    return v;
}

fn int_of_text[&s](text: &s [byte]) -> [] int {
    var v = 0;
    var k = 0;
    while k < len(text) {
        v = v * 10 + (int_of(text[k]) - '0');
        k = k + 1;
    }
    return v;
}

// The k-th space-separated token of the line.
fn token[&s](line: &s [byte], k: int) -> [] &s [byte] {
    var p = 0;
    var seen = 0;
    while p < len(line) {
        while p < len(line) && int_of(line[p]) == 32 {
            p = p + 1;
        }
        let a = p;
        while p < len(line) && int_of(line[p]) != 32 {
            p = p + 1;
        }
        if p > a {
            if seen == k {
                return line[a..p];
            }
            seen = seen + 1;
        }
    }
    return line[0..0];
}

fn one_line[&h, &i, &s](heap: &!h Heap, io: &!i Io, line: &s [byte]) -> [heap, io_write] int {
    let op = token(line, 0);
    var out = buffer.empty(heap, 64);
    if bytes.equal(op, "fixed") {
        out = numfmt.put_fixed(heap, out, number(token(line, 2)), int_of_text(token(line, 1)));
    } else if bytes.equal(op, "sci") {
        out = numfmt.put_sci(heap, out, number(token(line, 2)), int_of_text(token(line, 1)));
    } else if bytes.equal(op, "general") {
        out = numfmt.put_general(heap, out, number(token(line, 1)));
    } else if bytes.equal(op, "repr") {
        out = numfmt.put_repr(heap, out, number(token(line, 1)));
    } else if bytes.equal(op, "round") {
        out = numfmt.put_repr(heap, out, numfmt.round_nd(number(token(line, 2)), int_of_text(token(line, 1))));
    }
    borrow out as &ob in {
        buffer.write(io, ob);
    }
    io.newline(io);
    buffer.drop(heap, out);
    return 0;
}

fn run[&h, &i](heap: &!h Heap, io: &!i Io) -> [heap, io_read, io_write] int {
    var line = buffer.empty(heap, 128);
    var c = getchar(io);
    while c >= 0 {
        if c == 10 {
            borrow line as &lb in {
                one_line(heap, io, buffer.bytes(lb));
            }
            borrow mut line as &!lm in {
                buffer.clear(lm);
            }
        } else {
            line = buffer.push(heap, line, byte_of(c));
        }
        c = getchar(io);
    }
    buffer.drop(heap, line);
    return 0;
}

fn main(world: World) -> [] int {
    let Split { io, ffi, fs, heap, args } = split(world);
    release(ffi);
    release(fs);
    release(args);
    borrow mut heap as &!h in {
        borrow mut io as &!i in {
            run(h, i);
        }
    }
    release(heap);
    release(io);
    return 0;
}
