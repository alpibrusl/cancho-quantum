module site.facts;

import site.numfmt;
import std.buffer;
import std.bytes;

// The page's facts: named values (integers, floats, texts) that the templates in docs/page/ refer to as `{{name}}`
// or `{{name:.4f}}`. Fixed-capacity slices passed by the caller, so any function can add one and nothing is moved:
//
//   names   the names, one after the other, each ended by a newline        (names_size() bytes)
//   texts   the text values                                                (texts_size() bytes)
//   ints    ints[0] entries, ints[1] bytes of names used, ints[2] bytes of texts used; entry k at 8 + 4k:
//           kind (1 int, 2 float, 3 text), where its name starts, then the value (the int, the index into
//           `floats`, or the text's start and end in `texts`)
//   floats  the float values, entry k at k

pub fn names_size() -> [] int {
    return 32768;
}

pub fn texts_size() -> [] int {
    return 8388608;
}

pub fn ints_size() -> [] int {
    return 8 + 4 * 1024;
}

pub fn floats_size() -> [] int {
    return 1024;
}

// The entry for `name`, or -1.
pub fn find[&n, &i, &s](names: &n [byte], ints: &i [int], name: &s [byte]) -> [] int {
    var k = 0;
    while k < ints[0] {
        let start = ints[8 + 4 * k + 1];
        var e = start;
        while int_of(names[e]) != 10 {
            e = e + 1;
        }
        if bytes.equal(names[start..e], name) {
            return k;
        }
        k = k + 1;
    }
    return 0 - 1;
}

// The slot to write `name` into: its old entry, or a new one.
fn slot[&n, &i, &s](names: &!n [byte], ints: &!i [int], name: &s [byte]) -> [] int {
    let old = find(names, ints, name);
    if old >= 0 {
        return old;
    }
    let k = ints[0];
    let used = ints[1];
    var j = 0;
    while j < len(name) {
        names[used + j] = name[j];
        j = j + 1;
    }
    names[used + len(name)] = byte_of(10);
    ints[8 + 4 * k + 1] = used;
    ints[1] = used + len(name) + 1;
    ints[0] = k + 1;
    return k;
}

pub fn set_int[&n, &i, &s](names: &!n [byte], ints: &!i [int], name: &s [byte], v: int) -> [] int {
    let k = slot(names, ints, name);
    ints[8 + 4 * k] = 1;
    ints[8 + 4 * k + 2] = v;
    return 0;
}

pub fn set_float[&n, &i, &f, &s](names: &!n [byte], ints: &!i [int], floats: &!f [float], name: &s [byte], v: float) -> [] int {
    let k = slot(names, ints, name);
    ints[8 + 4 * k] = 2;
    ints[8 + 4 * k + 2] = k;
    floats[k] = v;
    return 0;
}

pub fn set_text[&n, &i, &t, &s, &v](names: &!n [byte], ints: &!i [int], texts: &!t [byte], name: &s [byte], value: &v [byte]) -> [] int {
    let k = slot(names, ints, name);
    let used = ints[2];
    var j = 0;
    while j < len(value) {
        texts[used + j] = value[j];
        j = j + 1;
    }
    ints[8 + 4 * k] = 3;
    ints[8 + 4 * k + 2] = used;
    ints[8 + 4 * k + 3] = used + len(value);
    ints[2] = used + len(value);
    return 0;
}

// `{{name}}` / `{{name:spec}}`: append the fact's text. Specs: `.Nf`, `.Ne`, `g` for a float (none: Python's
// `str`), none for an int or a text. Answers the buffer; an unknown name traps, because a page with a hole in it
// is worse than no page.
pub fn put_fact[&h, &n, &i, &t, &f, &s, &p](heap: &!h Heap, buf: buffer.Buffer, names: &n [byte], ints: &i [int], texts: &t [byte], floats: &f [float], name: &s [byte], spec: &p [byte]) -> [heap] buffer.Buffer {
    let k = find(names, ints, name);
    if k < 0 {
        let unknown = trap();
    }
    let kind = ints[8 + 4 * k];
    if kind == 1 {
        let v = ints[8 + 4 * k + 2];
        if v < 0 {
            return buffer.push_nat(heap, buffer.push(heap, buf, byte_of('-')), 0 - v);
        }
        return buffer.push_nat(heap, buf, v);
    }
    if kind == 3 {
        return buffer.append(heap, buf, texts[ints[8 + 4 * k + 2]..ints[8 + 4 * k + 3]]);
    }
    let x = floats[ints[8 + 4 * k + 2]];
    if len(spec) == 0 {
        return numfmt.put_repr(heap, buf, x);
    }
    if int_of(spec[0]) == 'g' {
        return numfmt.put_general(heap, buf, x);
    }
    // .Nf or .Ne
    var nd = 0;
    var p = 1;
    while p + 1 < len(spec) {
        nd = nd * 10 + (int_of(spec[p]) - '0');
        p = p + 1;
    }
    if int_of(spec[len(spec) - 1]) == 'e' {
        return numfmt.put_sci(heap, buf, x, nd);
    }
    return numfmt.put_fixed(heap, buf, x, nd);
}

// Fill the template: every `{{name}}` or `{{name:spec}}` is replaced by the fact, everything else is copied.
pub fn render[&h, &n, &i, &t, &f, &s](heap: &!h Heap, buf: buffer.Buffer, tmpl: &s [byte], names: &n [byte], ints: &i [int], texts: &t [byte], floats: &f [float], upper: bool) -> [heap] buffer.Buffer {
    var out = buf;
    var k = 0;
    while k < len(tmpl) {
        if k + 1 < len(tmpl) && int_of(tmpl[k]) == '{' && int_of(tmpl[k + 1]) == '{' {
            var e = k + 2;
            while e + 1 < len(tmpl) && !(int_of(tmpl[e]) == '}' && int_of(tmpl[e + 1]) == '}') {
                e = e + 1;
            }
            // name[:spec]
            var colon = k + 2;
            while colon < e && int_of(tmpl[colon]) != ':' {
                colon = colon + 1;
            }
            var spec = tmpl[e..e];
            if colon < e {
                spec = tmpl[colon + 1..e];
            }
            // `{{NAME}}` in capitals is a placeholder of the whole page: left for the page-level fill (`upper`)
            let first = int_of(tmpl[k + 2]);
            if first >= 'A' && first <= 'Z' && !upper {
                out = buffer.append(heap, out, tmpl[k..e + 2]);
            } else {
                out = put_fact(heap, out, names, ints, texts, floats, tmpl[k + 2..colon], spec);
            }
            k = e + 2;
        } else {
            out = buffer.push(heap, out, tmpl[k]);
            k = k + 1;
        }
    }
    return out;
}
