edition 7;

module site.live;

import site.files;
import site.text;
import std.buffer;
import std.bytes;
import std.io;
import std.process;

// Running the commands the site builder asks for.
//
// The builder (`site.cho`) takes every command's answer from a transcript, so it can be tested without running
// anything. Live, the same program is its own driver: it starts the builder as a child with a transcript that holds an
// exploring entry (the key `\3`); each command the transcript lacks is named on the child's standard error
// (`site: miss: KEY`, see `util.entry`) and answered with an empty entry, and the child goes on. The driver runs the
// commands it was told of, adds their answers to the transcript and starts the child again, until a run names none.
// The child's output then is the page. The transcript is the one `scripts/build_site.py --transcript` records, so it
// is also what `scripts/check_site.py` compares.
//
// A key is `argv joined by \1`, then `\2`, then the standard input. `$TMP/` at the start of an argument stands for the
// `--tmp` prefix (a file name prefix: the language cannot make a directory), and the command `cancho` for `--compiler`.

// The names of the sources `qsim` is built from, as `ls src` gives them.
fn qsim_sources[&h](heap: &!h Heap, argv: buffer.Buffer) -> [heap] buffer.Buffer {
    var a = argv;
    a = buffer.append(heap, a, "src/complex.cho\0src/density.cho\0src/dump.cho\0src/gates.cho\0src/main.cho\0src/measure.cho\0");
    a = buffer.append(heap, a, "src/noise.cho\0src/profile.cho\0src/qasm.cho\0src/qpu.cho\0src/qubit.cho\0src/reader.cho\0src/state.cho\0");
    return a;
}

// The library the accept fixtures are built with.
fn lib_sources[&h](heap: &!h Heap, argv: buffer.Buffer) -> [heap] buffer.Buffer {
    return buffer.append(heap, argv, "src/complex.cho\0src/state.cho\0src/gates.cho\0src/profile.cho\0src/measure.cho\0src/noise.cho\0src/qubit.cho\0");
}

fn add_word[&h, &s](heap: &!h Heap, argv: buffer.Buffer, word: &s [byte]) -> [heap] buffer.Buffer {
    return buffer.push(heap, buffer.append(heap, argv, word), byte_of(0));
}

// The Linux number of a signal `Ran::Signaled` names by its `std.signals` bit. A signal with no bit is answered as `0`; of
// those, a cancho trap is the one this builder runs into (SIGILL, 4, on Linux), so that is what `0` stands for.
fn signal_number(bit: int) -> [] int {
    if bit == 1 {
        return 1;
    }
    if bit == 2 {
        return 2;
    }
    if bit == 4 {
        return 3;
    }
    if bit == 8 {
        return 15;
    }
    if bit == 16 {
        return 10;
    }
    if bit == 32 {
        return 12;
    }
    if bit == 64 {
        return 14;
    }
    if bit == 128 {
        return 28;
    }
    if bit == 256 {
        return 9;
    }
    return 4;
}

// The program `exe` started with `argv` (each entry followed by a NUL, not including its own name) and `input` on its
// standard input; its exit status (as Python's `returncode`, minus the signal's number when it was ended by one; 255 when it could not be run or watched), standard output and standard error.
pub fn run[&h, &i, &x, &c, &p, &a, &n](heap: &!h Heap, io: &!i Io, exec: &x Exec(""), clock: &c Clock, exe: &p [byte], argv: &a [byte], input: &n [byte]) -> [heap, err_write, exec(""), clock, poll] (int, buffer.Buffer, buffer.Buffer) {
    var out = buffer.empty(heap, 0);
    var err = buffer.empty(heap, 0);
    var rc = 255;
    match process.channels_with_errors() {
        process.ChannelsWithErrors::Failed(e) => {
            io.error_all(io, "site: cannot make the pipes to run a program with\n");
        }
        process.ChannelsWithErrors::Ok(to_child, child_in, from_child, child_out, from_errors, child_errors) => {
            match exec_spawn(exec, exe, argv, "PATH=/usr/local/bin:/usr/bin:/bin\0HOME=/tmp\0", Stdio::Pipe(child_in), Stdio::Pipe(child_out), Stdio::Pipe(child_errors)) {
                Spawned::Failed(e) => {
                    process.close(to_child, from_child);
                    pipe_close(from_errors);
                    io.error_all(io, "site: cannot start ");
                    io.error_all(io, exe);
                    io.error_all(io, "\n");
                }
                Spawned::Ok(child) => {
                    let (got, errors, ran) = process.capture_both(heap, clock, child, to_child, from_child, from_errors, input, 268435456, 268435456, 3600000);
                    buffer.drop(heap, out);
                    buffer.drop(heap, err);
                    out = got;
                    err = errors;
                    match ran {
                        process.Ran::Code(n) => {
                            rc = n;
                        }
                        process.Ran::Signaled(s) => {
                            rc = 0 - signal_number(s);
                        }
                        process.Ran::TimedOut => {
                            io.error_all(io, "site: a program did not finish in an hour\n");
                        }
                        process.Ran::TooMuch => {
                            io.error_all(io, "site: a program wrote too much\n");
                        }
                        process.Ran::Failed(e) => {
                            io.error_all(io, "site: a program could not be watched\n");
                        }
                    }
                }
            }
        }
    }
    return (rc, out, err);
}

// `text` with every `pattern` replaced by `with`.
fn replace_all[&h, &t, &p, &w](heap: &!h Heap, text: &t [byte], pattern: &p [byte], with: &w [byte]) -> [heap] buffer.Buffer {
    var out = buffer.empty(heap, len(text) + 16);
    var at = 0;
    var more = true;
    while more {
        let rest = text[at..len(text)];
        let k = bytes.find(rest, pattern);
        if k < 0 {
            out = buffer.append(heap, out, rest);
            more = false;
        } else {
            out = buffer.append(heap, buffer.append(heap, out, rest[0..k]), with);
            at = at + k + len(pattern);
        }
    }
    return out;
}

// `prefix` and `name` joined.
fn joined[&h, &a, &b](heap: &!h Heap, first: &a [byte], second: &b [byte]) -> [heap] buffer.Buffer {
    return buffer.append(heap, buffer.append(heap, buffer.empty(heap, len(first) + len(second) + 1), first), second);
}

// Build the program of `argv` (without the program's own name) and say so if it fails.
fn build[&h, &i, &x, &c, &q, &a](heap: &!h Heap, io: &!i Io, exec: &x Exec(""), clock: &c Clock, compiler: &q [byte], argv: &a [byte]) -> [heap, err_write, exec(""), clock, poll] int {
    let (rc, out, err) = run(heap, io, exec, clock, compiler, argv, "");
    if rc != 0 {
        io.error_all(io, "site: the compiler failed:\n");
        borrow err as &er in {
            io.error_all(io, buffer.bytes(er));
        }
        borrow out as &ou in {
            io.error_all(io, buffer.bytes(ou));
        }
    }
    buffer.drop(heap, out);
    buffer.drop(heap, err);
    return rc;
}

// `$TMP/qsim` and `$TMP/qprofile`, built.
pub fn build_tools[&h, &i, &x, &c, &f, &q, &t](heap: &!h Heap, io: &!i Io, exec: &x Exec(""), clock: &c Clock, fs: &f Fs(""), compiler: &q [byte], tmp: &t [byte]) -> [heap, err_write, exec(""), clock, poll] int {
    var a = buffer.empty(heap, 512);
    a = add_word(heap, a, "build");
    a = qsim_sources(heap, a);
    a = add_word(heap, a, "--std");
    a = add_word(heap, a, "-o");
    let target = joined(heap, tmp, "qsim");
    borrow target as &tr in {
        a = add_word(heap, a, buffer.bytes(tr));
    }
    buffer.drop(heap, target);
    var rc = 0;
    borrow a as &ar in {
        rc = build(heap, io, exec, clock, compiler, buffer.bytes(ar));
    }
    buffer.drop(heap, a);
    if rc != 0 {
        return rc;
    }
    var b = buffer.empty(heap, 128);
    b = add_word(heap, b, "build");
    b = add_word(heap, b, "tools/qprofile.cho");
    b = add_word(heap, b, "--std");
    b = add_word(heap, b, "-o");
    let target2 = joined(heap, tmp, "qprofile");
    borrow target2 as &tr2 in {
        b = add_word(heap, b, buffer.bytes(tr2));
    }
    buffer.drop(heap, target2);
    borrow b as &br in {
        rc = build(heap, io, exec, clock, compiler, buffer.bytes(br));
    }
    buffer.drop(heap, b);
    return rc;
}

// `$TMP/acc-NAME`, built from tests/accept/NAME.cho and the library. `tele_mut` is the teleport fixture with its
// first correction made impossible (`m0 == 1` becomes `m0 == 7`): the check that the check is not vacuous.
fn build_accept[&h, &i, &x, &c, &f, &q, &t, &n](heap: &!h Heap, io: &!i Io, exec: &x Exec(""), clock: &c Clock, fs: &f Fs(""), compiler: &q [byte], tmp: &t [byte], name: &n [byte]) -> [heap, err_write, exec(""), clock, poll, fs_read(""), fs_write("")] int {
    var source = joined(heap, "tests/accept/", name);
    source = buffer.append(heap, source, ".cho");
    if bytes.equal(name, "tele_mut") {
        buffer.drop(heap, source);
        source = joined(heap, tmp, "tele_mut.cho");
        let (original, got) = files.read_all(heap, fs, "tests/accept/teleport.cho", 1048576);
        borrow original as &or in {
            let changed = replace_all(heap, buffer.bytes(or), "if m0 == 1 {", "if m0 == 7 {");
            borrow changed as &chr in {
                borrow source as &sr in {
                    if fs_write(fs, buffer.bytes(sr), buffer.bytes(chr)) < 0 {
                        io.error_all(io, "site: cannot write the mutated fixture\n");
                    }
                }
            }
            buffer.drop(heap, changed);
        }
        buffer.drop(heap, original);
    }
    var a = buffer.empty(heap, 512);
    a = add_word(heap, a, "build");
    a = lib_sources(heap, a);
    borrow source as &sr2 in {
        a = add_word(heap, a, buffer.bytes(sr2));
    }
    buffer.drop(heap, source);
    a = add_word(heap, a, "--std");
    a = add_word(heap, a, "-o");
    var target = joined(heap, tmp, "acc-");
    target = buffer.append(heap, target, name);
    borrow target as &tr in {
        a = add_word(heap, a, buffer.bytes(tr));
    }
    buffer.drop(heap, target);
    var rc = 0;
    borrow a as &ar in {
        rc = build(heap, io, exec, clock, compiler, buffer.bytes(ar));
    }
    buffer.drop(heap, a);
    return rc;
}

// What the command with this key prints, as the transcript holds it: the status, standard output and standard error.
pub fn answer[&h, &i, &x, &c, &f, &q, &t, &k](heap: &!h Heap, io: &!i Io, exec: &x Exec(""), clock: &c Clock, fs: &f Fs(""), compiler: &q [byte], tmp: &t [byte], key: &k [byte]) -> [heap, err_write, exec(""), clock, poll, fs_read(""), fs_write("")] (int, buffer.Buffer, buffer.Buffer) {
    var split = 0;
    while split < len(key) && int_of(key[split]) != 2 {
        split = split + 1;
    }
    let head = key[0..split];
    var input = key[0..0];
    if split < len(key) {
        input = key[split + 1..len(key)];
    }
    var exe = buffer.empty(heap, 64);
    var argv = buffer.empty(heap, 256);
    var from = 0;
    var at = 0;
    var first = true;
    while at <= len(head) {
        if at == len(head) || int_of(head[at]) == 1 {
            let word = head[from..at];
            if first {
                first = false;
                if bytes.equal(word, "cancho") {
                    exe = buffer.append(heap, exe, compiler);
                } else if bytes.starts_with(word, "$TMP/") {
                    exe = buffer.append(heap, buffer.append(heap, exe, tmp), word[5..len(word)]);
                } else {
                    exe = buffer.append(heap, exe, word);
                }
                if bytes.starts_with(word, "$TMP/acc-") {
                    let built = build_accept(heap, io, exec, clock, fs, compiler, tmp, word[9..len(word)]);
                }
            } else if bytes.starts_with(word, "$TMP/") {
                argv = buffer.push(heap, buffer.append(heap, buffer.append(heap, argv, tmp), word[5..len(word)]), byte_of(0));
            } else {
                argv = add_word(heap, argv, word);
            }
            from = at + 1;
        }
        at = at + 1;
    }
    var rc = 255;
    var out = buffer.empty(heap, 0);
    var err = buffer.empty(heap, 0);
    borrow exe as &er2 in {
        borrow argv as &ar in {
            let (r, o, e) = run(heap, io, exec, clock, buffer.bytes(er2), buffer.bytes(ar), input);
            buffer.drop(heap, out);
            buffer.drop(heap, err);
            rc = r;
            out = o;
            err = e;
        }
    }
    buffer.drop(heap, exe);
    buffer.drop(heap, argv);
    return (rc, out, err);
}

// The key a miss line names: `error_key`'s form, undone.
fn unescape[&h, &s](heap: &!h Heap, line: &s [byte]) -> [heap] buffer.Buffer {
    var out = buffer.empty(heap, len(line) + 1);
    var at = 0;
    while at < len(line) {
        let c = int_of(line[at]);
        if c == 92 && at + 1 < len(line) {
            let d = int_of(line[at + 1]);
            if d == '1' {
                out = buffer.push(heap, out, byte_of(1));
            } else if d == '2' {
                out = buffer.push(heap, out, byte_of(2));
            } else if d == '3' {
                out = buffer.push(heap, out, byte_of(3));
            } else if d == 'n' {
                out = buffer.push(heap, out, byte_of(10));
            } else if d == 'r' {
                out = buffer.push(heap, out, byte_of(13));
            } else {
                out = buffer.push(heap, out, byte_of(d));
            }
            at = at + 2;
        } else {
            out = buffer.push(heap, out, line[at]);
            at = at + 1;
        }
    }
    return out;
}

// One transcript entry, as `"KEY":{"rc":N,"out":"...","err":"..."}`, added to `members` (comma first, unless it is empty).
fn add_member[&h, &k, &o, &e](heap: &!h Heap, members: buffer.Buffer, key: &k [byte], rc: int, out: &o [byte], err: &e [byte]) -> [heap] buffer.Buffer {
    var m = members;
    var any = false;
    borrow m as &mb in {
        any = buffer.size(mb) > 0;
    }
    if any {
        m = text.put(heap, m, ",");
    }
    m = text.put_json_string(heap, m, key);
    m = text.put(heap, m, ":{\"rc\":");
    m = text.put_int(heap, m, rc);
    m = text.put(heap, m, ",\"out\":");
    m = text.put_json_string(heap, m, out);
    m = text.put(heap, m, ",\"err\":");
    m = text.put_json_string(heap, m, err);
    return text.put(heap, m, "}");
}

// The exploring entry, which makes `util.entry` name what is missing instead of stopping.
fn explore_member() -> [] &static [byte] {
    return ",\"\\u0003\":{\"rc\":0,\"out\":\"\",\"err\":\"\"}";
}

// Answer the misses `err` names (its lines `site: miss: KEY`); the number answered.
fn answer_misses[&h, &i, &x, &c, &f, &q, &t, &e](heap: &!h Heap, io: &!i Io, exec: &x Exec(""), clock: &c Clock, fs: &f Fs(""), compiler: &q [byte], tmp: &t [byte], err: &e [byte], members: buffer.Buffer) -> [heap, err_write, exec(""), clock, poll, fs_read(""), fs_write("")] (int, buffer.Buffer) {
    var m = members;
    var count = 0;
    var from = 0;
    var at = 0;
    while at <= len(err) {
        if at == len(err) || int_of(err[at]) == 10 {
            let line = err[from..at];
            if bytes.starts_with(line, "site: miss: ") {
                let key = unescape(heap, line[12..len(line)]);
                borrow key as &kr in {
                    let (rc, out, er) = answer(heap, io, exec, clock, fs, compiler, tmp, buffer.bytes(kr));
                    borrow out as &or in {
                        borrow er as &err_ref in {
                            m = add_member(heap, m, buffer.bytes(kr), rc, buffer.bytes(or), buffer.bytes(err_ref));
                        }
                    }
                    buffer.drop(heap, out);
                    buffer.drop(heap, er);
                }
                buffer.drop(heap, key);
                count = count + 1;
            }
            from = at + 1;
        }
        at = at + 1;
    }
    return (count, m);
}

// Build the page by running what it needs. `me` is this program, `forward` the arguments (each followed by a NUL) the final run
// is given besides `--transcript`; `transcript` and `dump` are the files the exploring runs use.
pub fn drive[&h, &i, &x, &c, &f, &q, &t, &m, &r, &d, &w](heap: &!h Heap, io: &!i Io, exec: &x Exec(""), clock: &c Clock, fs: &f Fs(""), compiler: &q [byte], tmp: &t [byte], me: &m [byte], forward: &w [byte], transcript: &r [byte], dump: &d [byte]) -> [heap, io_write, err_write, exec(""), clock, poll, fs_read(""), fs_write("")] int {
    var status = build_tools(heap, io, exec, clock, fs, compiler, tmp);
    var members = buffer.empty(heap, 65536);
    var rounds = 0;
    var done = false;
    while status == 0 && !done {
        rounds = rounds + 1;
        if rounds > 64 {
            io.error_all(io, "site: the commands the page needs keep changing\n");
            status = 1;
        } else {
            var doc = text.put(heap, buffer.empty(heap, 65536), "{");
            var any = false;
            borrow members as &mr in {
                doc = text.put_bytes(heap, doc, buffer.bytes(mr));
                any = buffer.size(mr) > 0;
            }
            if any {
                doc = text.put(heap, doc, explore_member());
            } else {
                doc = text.put(heap, doc, "\"\\u0003\":{\"rc\":0,\"out\":\"\",\"err\":\"\"}");
            }
            doc = text.put(heap, doc, "}");
            borrow doc as &dr in {
                if fs_write(fs, transcript, buffer.bytes(dr)) < 0 {
                    io.error_all(io, "site: cannot write the transcript\n");
                    status = 2;
                }
            }
            buffer.drop(heap, doc);
            if status == 0 {
                var a = buffer.empty(heap, 256);
                a = add_word(heap, a, "--transcript");
                a = add_word(heap, a, transcript);
                a = add_word(heap, a, "--dump");
                a = add_word(heap, a, dump);
                borrow a as &ar in {
                    let (rc, out, err) = run(heap, io, exec, clock, me, buffer.bytes(ar), "");
                    borrow err as &er in {
                        let (misses, grown) = answer_misses(heap, io, exec, clock, fs, compiler, tmp, buffer.bytes(er), members);
                        members = grown;
                        if misses == 0 {
                            if rc == 0 {
                                done = true;
                            } else {
                                io.error_all(io, buffer.bytes(er));
                                status = rc;
                            }
                        }
                    }
                    buffer.drop(heap, out);
                    buffer.drop(heap, err);
                }
                buffer.drop(heap, a);
            }
        }
    }
    buffer.drop(heap, members);
    if status != 0 {
        return status;
    }
    var b = buffer.empty(heap, 256);
    b = add_word(heap, b, "--transcript");
    b = add_word(heap, b, transcript);
    b = buffer.append(heap, b, forward);
    borrow b as &br in {
        let (rc, out, err) = run(heap, io, exec, clock, me, buffer.bytes(br), "");
        borrow out as &or in {
            buffer.write(io, or);
        }
        borrow err as &er in {
            io.error_all(io, buffer.bytes(er));
        }
        buffer.drop(heap, out);
        buffer.drop(heap, err);
        status = rc;
    }
    buffer.drop(heap, b);
    return status;
}
