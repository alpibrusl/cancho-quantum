edition 8;

import std.io;
import std.buffer;
import labio;

// hist.cho -- qsim's `sample` output counted again by an FPGA, and the two counts compared.
//
//   printf 'n 3\nh 0\ncx 0 1\ncx 1 2\nseed 7\nsample 1000\n' | qsim | hist
//
// qsim prints one line per distinct outcome, `sample <bits> <count>` (src/dump.cho), not the shots in order. This program sends the board
// <count> shots of each outcome, in the order printed, through the histogram of the lab design (cancho-hdl: rtl/lab.v, lab/lab.chw), then
// reads every bin back and compares it with qsim's count. What it shows is that the board counts exactly what it is sent; it does not
// show anything about how qsim draws its samples, which this does not touch. n at most 12 qubits (4096 bins), at most 65535 shots per outcome.
// Authority: standard input and output, the Tty capability under /dev, a poll. No filesystem, no network, no foreign call.
// Exit: 0 all bins equal, 1 a bin differs, 3 to 7 the port or the board, 2 nothing to count.

fn main(world: World) -> [] int {
    let Split { io, ffi, fs, heap, args, net, clock, signals, exec, tty } = split(world);
    release(ffi); release(fs); release(args); release(net); release(signals); release(exec); release(clock);
    let device = narrow(tty, "/dev");
    var status_code = 0;
    var failures = 0;
    match poller_new() {
        Polling::Failed(e) => { release(device); release(io); release(heap); return 1; }
        Polling::Ok(open) => {
            var p = open;
            borrow device as &t in {
                match tty_open(t, "/dev/ttyUSB1") {
                    TtyOpened::Failed(errno) => { status_code = 3; }
                    TtyOpened::Ok(port) => {
                        borrow mut port as &!q in {
                            if tty_configure(q, 115200) != 0 { status_code = 4; }
                            tty_flush_input(q);
                            borrow mut p as &!pw in { poller_add_tty(pw, q, 1, 1); }
                            borrow mut p as &!pw in {
                                region r {
                                    let frame = alloc_slice[r](9, byte_of(0));
                                    let cmd = alloc_slice[r](5, byte_of(0));
                                    let ans = alloc_slice[r](8, byte_of(0));
                                    let want = alloc_slice[r](4096, 0);
                                    let line = alloc_slice[r](256, byte_of(0));
                                    var n = 0;
                                    var shots = 0;
                                    labio.write_reg(q, pw, frame, ans, 0, 4);        // clear the bins
                                    labio.pause(pw, 5);
                                    labio.write_reg(q, pw, frame, ans, 0, 0);
                                    var tog = 0;
                                    var len = 0;
                                    var going = true;
                                    while going && status_code == 0 {
                                        var c = 0 - 1;
                                        borrow mut io as &!i in { c = getchar(i); }
                                        if c >= 0 && c != 10 {
                                            if len < 255 { line[len] = byte_of(c); len = len + 1; }
                                        } else {
                                            // one line: `sample <bits> <count>`
                                            if len > 8 && int_of(line[0]) == 115 && int_of(line[1]) == 97 && int_of(line[2]) == 109 && int_of(line[3]) == 112 && int_of(line[4]) == 108 && int_of(line[5]) == 101 && int_of(line[6]) == 32 {
                                                var outcome = 0;
                                                var j = 7;
                                                while j < len && int_of(line[j]) != 32 {
                                                    outcome = outcome * 2 + (int_of(line[j]) - 48);
                                                    j = j + 1;
                                                }
                                                n = j - 7;
                                                var count = 0;
                                                j = j + 1;
                                                while j < len {
                                                    count = count * 10 + (int_of(line[j]) - 48);
                                                    j = j + 1;
                                                }
                                                if n >= 1 && n <= 12 {
                                                    want[outcome] = want[outcome] + count;
                                                    var s = 0;
                                                    while s < count {
                                                        tog = 1 - tog;
                                                        if labio.write_reg(q, pw, frame, ans, 44, tog * 4096 + outcome) != 0 { status_code = 5; }
                                                        shots = shots + 1;
                                                        s = s + 1;
                                                    }
                                                }
                                            }
                                            len = 0;
                                            if c < 0 { going = false; }
                                        }
                                    }
                                    if shots == 0 && status_code == 0 { status_code = 2; }
                                    var bins = 1;
                                    var z = 0;
                                    while z < n { bins = bins * 2; z = z + 1; }
                                    var b = 0;
                                    while b < bins && status_code == 0 {
                                        labio.write_reg(q, pw, frame, ans, 48, b);
                                        labio.pause(pw, 2);
                                        let got = labio.read_reg(q, pw, cmd, ans, 52);
                                        if got != want[b] { failures = failures + 1; }
                                        if want[b] > 0 || got != 0 {
                                            borrow mut heap as &!h in {
                                                var out = buffer.empty(h, 80);
                                                out = buffer.append(h, out, "bin ");
                                                var bit = n - 1;
                                                while bit >= 0 { out = buffer.push(h, out, byte_of(48 + (b >> bit) % 2)); bit = bit - 1; }
                                                out = buffer.append(h, out, "  qsim ");
                                                out = buffer.push_nat(h, out, want[b]);
                                                out = buffer.append(h, out, "  board ");
                                                out = buffer.push_nat(h, out, got);
                                                if got != want[b] { out = buffer.append(h, out, "  DIFFERENT"); }
                                                out = buffer.push(h, out, byte_of(10));
                                                borrow mut io as &!i2 in { borrow out as &ob in { io.write_all(i2, buffer.bytes(ob)); } }
                                                buffer.drop(h, out);
                                            }
                                        }
                                        b = b + 1;
                                    }
                                    let total = labio.read_reg(q, pw, cmd, ans, 56);
                                    borrow mut heap as &!h in { borrow mut io as &!i in {
                                        labio.say(h, i, "shots sent: ", shots, "");
                                        labio.say(h, i, "total counted by the board: ", total, "");
                                        labio.say(h, i, "bins different from qsim's counts: ", failures, "");
                                    } }
                                    if total != shots { failures = failures + 1; }
                                }
                            }
                        }
                        tty_close(port);
                    }
                }
            }
            release(device);
            poller_close(p);
        }
    }
    release(io);
    release(heap);
    if status_code != 0 { return status_code; }
    if failures != 0 { return 1; }
    return 0;
}
