//~ RULE mode-bound-violated

// A run of qubits cannot live in a slice: ending a slice runs nothing, so
// a `res` element would be dropped rather than discharged.

import qc.qubit;
import qc.state;

fn register[&s](st: &!s [float]) -> [] int {
    region r {
        let qs = alloc_slice[r](2, qubit.fresh(2, 0));
    }
    return 0;
}

fn main(world: World) -> [] int {
    let Split { io, ffi, fs, heap, args } = split(world);
    release(io);
    release(ffi);
    release(fs);
    release(heap);
    release(args);
    return 0;
}
