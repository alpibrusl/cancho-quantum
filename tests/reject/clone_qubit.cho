//~ RULE linear-use-after-move

// No-cloning (must-reject #1): the first `measure` consumes the qubit, so
// there is nothing for the second to use.

import qc.qubit;
import qc.state;

fn clone[&s, &r](q: qubit.Qubit, st: &!s [float], rng: &!r [int]) -> [] int {
    let a = qubit.measure(q, st, rng);
    let b = qubit.measure(q, st, rng);
    return a + b;
}

fn main(world: World) -> [] int {
    let Split { io, ffi, fs, heap, args } = split(world);
    release(io);
    release(ffi);
    release(fs);
    release(heap);
    release(args);
    return 0;
}
