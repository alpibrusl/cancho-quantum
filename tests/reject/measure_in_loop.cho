//~ RULE linear-value-unconsumed

// A loop body must leave the live set as it found it; `measure` inside
// one consumes the qubit on the first pass and has nothing on the second.

import qc.qubit;
import qc.state;

fn repeat[&s, &r](q: qubit.Qubit, st: &!s [float], rng: &!r [int]) -> [] int {
    var i = 0;
    var total = 0;
    while i < 3 {
        total = total + qubit.measure(q, st, rng);
        i = i + 1;
    }
    return total;
}

fn main(world: World) -> [] int {
    let Split { io, ffi, fs, heap, args } = split(world);
    release(io);
    release(ffi);
    release(fs);
    release(heap);
    release(args);
    return 0;
}
