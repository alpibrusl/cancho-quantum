//~ RULE linear-use-after-move

// A budget cannot be copied (`src/qpu.cho`): two capabilities of 100 shots from one of 100 would allow 200. `shrink` consumes the one it narrows,
// so using the parent afterwards is a use after move, which is how the design's "a program has one chain of capabilities" holds.

import qc.qpu;

fn twice(q: qpu.Qpu) -> [] int {
    match qpu.shrink(q, 10) {
        qpu.Narrowed::Narrower(a) => {
            let spent_a = qpu.close(a);
            let spent_b = qpu.close(q);
            return spent_a + spent_b;
        }
        qpu.Narrowed::Refused(same) => {
            return qpu.close(same);
        }
    }
}

fn main(world: World) -> [] int {
    let Split { io, ffi, fs, heap, args } = split(world);
    release(io);
    release(ffi);
    release(fs);
    release(heap);
    release(args);
    return 0;
}
