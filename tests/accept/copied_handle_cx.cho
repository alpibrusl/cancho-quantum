// Must-reject #4, way 2: a `&!` copied into a second binding, then used as
// both operands (`aliasing.md` route 2). Accepted; traps at run time.
//~ TRAPS

import qc.qubit;
import qc.state;

fn copied[&s, &r](st: &!s [float], rng: &!r [int]) -> [] int {
    let q = qubit.fresh(2, 0);
    borrow mut q as &!x in {
        let y = x;
        qubit.cx(x, y, st);
    }
    return qubit.measure(q, st, rng);
}

fn run[&h](heap: &!h Heap) -> [heap] int {
    let amp = box_slice(heap, state.floats_for(2), 0.0);
    var out = 0;
    region r {
        let rng = alloc_slice[r](1, 7);
        borrow mut amp as &!w in {
            let st = contents(w);
            state.start(st);
            out = copied(st, rng);
        }
    }
    unbox_slice(heap, amp);
    return out;
}

fn main(world: World) -> [] int {
    let Split { io, ffi, fs, heap, args } = split(world);
    release(io);
    release(ffi);
    release(fs);
    release(args);
    var out = 0;
    borrow mut heap as &!h in {
        out = run(h);
    }
    release(heap);
    return out;
}
