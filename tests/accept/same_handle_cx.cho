// Must-reject #4, way 1 (`docs/qubit-types.md` §4.1): one borrowed qubit
// passed as both control and target. `&!r` is `val`, so the checker sees
// two copies of one pointer and accepts. The program traps at run time in
// `gates.cx`. If a rule ever refuses this file, move it to
// `tests/reject/` on purpose (compare `cancho/tests/accept/
// aliasing_same_place_twice.cho`).
//~ TRAPS

import qc.qubit;
import qc.state;

fn same[&s, &r](st: &!s [float], rng: &!r [int]) -> [] int {
    let q = qubit.fresh(2, 0);
    borrow mut q as &!x in {
        qubit.cx(x, x, st);
    }
    return qubit.measure(q, st, rng);
}

fn run[&h](heap: &!h Heap) -> [heap] int {
    let amp = box_slice(heap, state.floats_for(2), 0.0);
    var out = 0;
    region r {
        let rng = alloc_slice[r](1, 7);
        borrow mut amp as &!w in {
            let st = contents(w);
            state.start(st);
            out = same(st, rng);
        }
    }
    unbox_slice(heap, amp);
    return out;
}

fn main(world: World) -> [] int {
    let Split { io, ffi, fs, heap, args } = split(world);
    release(io);
    release(ffi);
    release(fs);
    release(args);
    var out = 0;
    borrow mut heap as &!h in {
        out = run(h);
    }
    release(heap);
    return out;
}
